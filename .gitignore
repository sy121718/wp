# 本地开发配置与密钥
config.yaml
.env
.env.*
!.env.example

# 编辑器和代码图谱本地状态
.cursor/
.code-review-graph/
graphify-out/

# 构建输出和可执行文件
/dist/
/app
/builder
coverage.out
# air 热重载的临时二进制与 build-errors.log
/tmp/

# 运行时数据落在源码树里的情况：日志/产物的 base_dir 是相对路径（config.yaml 的
# `public/logs`），从子目录启动进程时会落到 internal/routers/public/ 之类的路径下。
# 这类目录是纯产物（无 .go 文件），不该进仓库。
internal/**/public/logs/
internal/**/public/runtime/
internal/**/public/storage/
internal/**/public/builder-preview/

# 运行时数据和测试生成物
public/logs/
public/storage/
public/builder-preview/
public/wp/
public/runtime/

# 操作系统附加元数据
*:Zone.Identifier
.DS_Store

# Python 编译产物（scripts/ 下有辅助脚本）
__pycache__/
*.pyc

# 临时文件
*.log
*.tmp
# 本地凭据与参考站点存档
.wp-credentials.local

# archify 视觉检查产物
public/docs/*.visual-check.*

# 本地备份与临时工具
.backup/
cmd_tmp_login/

# 编辑器本地配置（各自环境不同，不入库）
.vscode/

# 本地演示/试验页面（public/a，随手放的 HTML，不是站点产物）
public/a/

# 数据库备份与原型稿（本地参考，不入库）
public/backup/

# DSH 技能缓存（本机状态，不入库）
.dsh-mattskillsdeck-cache/
.playwright-mcp/

# 在仓库根目录误跑 `go build ./cmd/xxx` 会在这里留下同名二进制（曾误提交 formtags /
# write-contracts 两个共 8MB+ 的文件）。构建产物一律不入库。
/formtags
/write-contracts
