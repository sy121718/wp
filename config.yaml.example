# 服务配置
server:
  port: 8080
  mode: debug  # debug, release, test
  app_name: go_wp
  read_header_timeout: 3s
  read_timeout: 15s
  write_timeout: 30s
  idle_timeout: 60s
  request_body_limit: 2MB
  upload_body_limit: 32MB
  rate_limit_enabled: true
  rate_limit_limit: 120
  rate_limit_window: 1m
  port_strategy: ""  # auto_release / report_only；留空时按 mode 推导
  cors_allowed_origins: []  # CORS 白名单；空时 release 模式拒绝跨域（不反射 Origin）、debug/test 模式反射回退
  # 站点对外协议（cookie 的 Secure 属性真源）：
  #   true  = 站点对外是 HTTPS —— 反向代理终结 TLS 时**也要写 true**（进程本身跑在 HTTP 上）
  #   false = 明确声明站点是纯 HTTP（内网 / 本地开发）
  # 未配置时按 server.mode 推导：release → true，debug/test → false。
  # 为什么不按 X-Forwarded-Proto 推断：那个头由上游产生、客户端可伪造，
  # 而「反代没传这个头」恰恰是自托管最常见的误配 —— 表现是「HTTPS 站点的 cookie
  # 悄悄丢了 Secure」，看起来一切正常。所以协议是配置事实，不是请求事实。
  site_https: false
  # debug/test 模式是否允许绑定非环回地址：
  #   false（默认）= 服务只监听 127.0.0.1；
  #   true          = 绑定全部接口（用手机 / 局域网设备连本地环境时才需要），启动打醒目警告。
  # debug 模式带三处放宽（一键登录、CORS 反射任意 Origin、信任所有代理），
  # 落到公网可达的地址上就是一条完整入侵路径，故默认收紧。
  debug_allow_public: false

# 数据库配置
database:
  driver: postgres  # mysql, postgres（sqlite / sql server 驱动已移除）
  host: 127.0.0.1
  port: 5432
  # 两角色分工（审计 DB-009 / DB-04）：
  #   · 业务连接 = 非超级的次级管理员角色（NOSUPERUSER NOBYPASSRLS，只给 DML / 序列权限）；
  #   · 迁移与运维脚本 = 管理连接（超级用户），它们需要 DDL 与 BYPASSRLS 能力。
  # 这里的 user 是**业务连接**。切换顺序不能反：先把各模块读写路径包上
  # pkg/rls.InProjectScope，**再**把 user 换成应用角色 —— 反过来会让没包 scope 的路径
  # 静默返回 0 行（fail closed 不报错）。步骤与回滚见 docs/rls-role-cutover.md。
  user: root
  # 建角色 / 授权的脚本在 scripts/rls-role-setup.sh；口令不落盘，走环境变量或
  # ~/.config/go_wp/rls-role.env（权限 600），脚本不会把口令打进 ps 的 argv。
  password: ""  # 生产环境推荐用环境变量 GOWP_DATABASE_PASSWORD 注入，勿落盘明文
  dbname: wp
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 1h
  conn_max_idle_time: 10m
  statement_timeout: 30s
  log_level: ""  # 留空时按 server.mode 推导
  prepare_stmt: false
  skip_default_transaction: false
  slow_threshold: 200ms
  # require_rls_role 要求连接角色不能绕过 RLS（默认 false）。
  #   · false：启动期只以 INFO 打印 session_user / current_user / rolsuper /
  #     rolbypassrls / 策略覆盖数；角色能绕过 RLS 时补一条 WARN。
  #   · true：同一探针发现连接角色是超级用户或带 BYPASSRLS 时**直接拒绝启动**。
  # 为什么默认 false：迁移与运维脚本复用同一个 database 组件、走管理连接（超级用户），
  # 默认 fail fast 会把正常运维挡在门外。**换成应用角色之后应置 true**，这道门禁才算闭环。
  # 非 PostgreSQL 驱动（mysql）整体跳过探针，不会因此报错。
  require_rls_role: false
  resolver:
    enabled: false
    policy: ""        # round_robin / random / weight
    sources: []       # 主库地址列表，预留结构
    replicas: []      # 从库地址列表，预留结构

# Redis配置
redis:
  provider: redis
  host: 127.0.0.1
  port: 6379
  password: ""
  db: 0
  addrs: []  # 集群/哨兵可填写多个地址，留空时使用 host:port
  enabled: true

# 认证配置（Session + Cookie）
auth:
  session_secret: ""  # 生产环境用 GOWP_AUTH_SESSION_SECRET 注入（release 模式至少 32 字符）

# Casbin 配置
casbin:
  enabled: true

# i18n 配置（数据库为唯一数据源）
i18n:
  default_lang: zh-CN
  auto_refresh: true
  refresh_interval: 20s
  # 站点访问路径的语言方案（多语言 P2/P3，docs/06-D §5 方案 A'）：
  #   default_plain = 默认语言**无前缀**（/about、/index），非默认语言用**短码**
  #                   （/en/about、/en/index）——推荐方案，默认值；
  #   all_prefix    = 全语言带短码前缀（/zh/about、/en/about），历史「全前缀」方案；
  #   off           = 全语言共用逻辑路径（/about），单语言站点兼容形态
  #                   （多语言无法同时在线，后发布者覆盖线上内容）。
  # 内部逻辑（数据库 lang 列 / sys_i18n / sys_translation / project_locales /
  # BuildContext.lang / 产物 Manifest.lang）始终使用**完整语言码**（zh-CN / en-US），
  # 只有 URL 路径段使用短码；映射表内置（zh-CN→zh、en-US→en …），未收录语言按
  # 「主语言子标签小写」确定性回退（fr-CA→fr），可用 lang_url_codes 覆盖。
  # 兼容：旧键 site_lang_prefix（bool）仍可识别——true → all_prefix、false → off。
  site_lang_url_mode: default_plain
  # lang_url_codes:        # 可选：语言码 → URL 短码覆盖表（短码冲突时必须显式配置）
  #   zh-CN: zh
  #   en-US: en

# 队列配置
queue:
  enabled: false
  provider: asynq
  run_worker: false
  concurrency: 10
  queues:
    critical: 6
    default: 3
    low: 1

# 日志配置
log:
  level: info  # debug, info, warn, error
  filename: public/logs/app.log
  base_dir: public/logs  # 日志基础目录
  capture:
    sql: false       # 是否开启 SQL 全局捕获（目录由入口传入）
    http: false      # 是否开启 HTTP 全局捕获（目录由入口传入）
  max_size: 100  # 日志文件最大大小（MB）
  max_backups: 10  # 最多保留旧文件数
  max_age: 30  # 最多保留天数
  compress: false  # 是否压缩
  sample:
    enabled: false
    initial: 100
    thereafter: 100
  scene_levels: {}  # 例如: { sql: error, http: warn }

# 上传配置
upload:
  enabled: true
  default_provider: local
  max_size: 10MB
  allowed_extensions: [".jpg", ".jpeg", ".png", ".gif", ".pdf", ".txt"]
  allowed_mime_types: ["image/jpeg", "image/png", "image/gif", "application/pdf", "text/plain"]

# 打点配置
analytics:
  # 打点匿名化（IP 哈希）用的独立盐。
  # 留空：用会话密钥经 HKDF 派生。功能可用，但轮换会话密钥会让历史 IP 哈希断档
  # （当前 ip_hash 只写不读，代价为零；将来若要做「按 IP 去重」，轮换前需保留旧盐），
  # 且盐与会话密钥同源 —— 盐泄露会波及会话签名 / CSRF / 购物车签名。
  # 建议生产环境显式配置：openssl rand -hex 32
  # 也可用 GOWP_ANALYTICS_PEPPER 环境变量注入。
  pepper: ""

# 购物车与支付签名的独立密钥（P1 密钥分离）
cart:
  # 购物车 cookie 的 HMAC 签名密钥。
  # 留空：回退到 auth.session_secret（行为与分离前完全一致），装配期记一条告警。
  # 分离的意义是**轮换不连带**：轮换会话密钥会让所有人重新登录（可接受），
  # 但不该顺带清空所有访客的购物车（那是业务损失）。
  # 建议生产环境显式配置：openssl rand -hex 32
  # 也可用 GOWP_CART_COOKIE_SECRET 环境变量注入。
  cookie_secret: ""
  # 支付通道回调的验签共享密钥（当前为模拟通道：HMAC-SHA256(secret, 原始报文)）。
  # 留空：回退到 auth.session_secret。
  # 这一项比 cookie_secret 更该配：轮换会话密钥时，**在途的支付回调会验签失败** ——
  # 那不只是清空购物车，而是可能丢支付结果。
  # 建议生产环境显式配置：openssl rand -hex 32
  # 也可用 GOWP_CART_PAYMENT_CALLBACK_SECRET 环境变量注入。
  payment_callback_secret: ""
