<div class="{{ .Classes }} sky-cardstack{{ if .V.Collection }} sky-cardstack--collection{{ end }}{{ if .V.HasContent }} sky-cardstack--content{{ else }}{{ if not .V.Collection }} sky-cardstack--num{{ end }}{{ end }}{{ if .V.Empty && .V.HideEmpty }} is-empty-hidden{{ end }}"{{ if .V.Slide }} data-cardstack-slide{{ end }}{{ if .V.Drag }} data-cardstack-drag tabindex="0" role="group" aria-label="可拖拽旋转的卡片环（左右方向键也可旋转）"{{ end }}{{ if .V.Deck }} data-cardstack-deck="{{ .V.DeckIndex }}"{{ if .V.DeckClickNext }} data-deck-click="next"{{ end }}{{ if .V.DeckLoop }} data-cardstack-loop="1"{{ end }}{{ if .V.DeckVertical }} data-cardstack-deck-axis="y"{{ end }} tabindex="0" role="group" aria-label="可滑动切换的卡片堆叠（左右方向键也可切换）"{{ end }}{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}><div class="sky-cardstack-track" data-cardstack-track>{{ if .V.Empty }}{{ if not .V.HideEmpty }}<p class="sky-cardstack-empty">{{ .V.EmptyText }}</p>{{ end }}{{ else }}{{ if .V.HasCardNodes }}{{ range _, group := .V.CardNodes }}<label class="sky-cardstack-card"><input type="radio" class="sky-cardstack-toggle" name="sky-cardstack-zoom" aria-label="放大这张卡片">{{ if .V.Slide }}<span class="sky-cardstack-page" data-total="{{ .V.PageTotal }}"></span>{{ end }}{{ range _, n := group }}{{ include n.Template n }}{{ end }}</label>{{ end }}{{ else if .V.Collection }}{{ range _, c := .V.Cards }}<label class="sky-cardstack-card"><input type="radio" class="sky-cardstack-toggle" name="sky-cardstack-zoom" aria-label="{{ c.AriaLabel }}">{{ if .V.Slide }}<span class="sky-cardstack-page" data-total="{{ .V.PageTotal }}"></span>{{ end }}{{ if c.HasImage }}<img class="sky-cardstack-img" src="{{ c.Image }}" alt="{{ c.Title }}" loading="lazy" decoding="async">{{ end }}{{ if c.HasTitle }}<h3 class="sky-cardstack-title">{{ c.Title }}</h3>{{ end }}{{ if c.HasText }}<p class="sky-cardstack-text">{{ c.Text }}</p>{{ end }}{{ if c.HasMeta }}<p class="sky-cardstack-meta">{{ c.Meta }}</p>{{ end }}{{ if c.HasHref }}<a class="sky-cardstack-link" href="{{ c.Href }}">{{ c.LinkText }}</a>{{ end }}</label>{{ end }}{{ else if .V.HasContent }}{{ range _, child := .Children }}<label class="sky-cardstack-card"><input type="radio" class="sky-cardstack-toggle" name="sky-cardstack-zoom" aria-label="放大这张卡片">{{ if .V.Slide }}<span class="sky-cardstack-page" data-total="{{ .V.PageTotal }}"></span>{{ end }}{{ include child.Template child }}</label>{{ end }}{{ else }}{{ range _, c := .V.Cards }}<label class="sky-cardstack-card"><input type="radio" class="sky-cardstack-toggle" name="sky-cardstack-zoom" aria-label="{{ c.AriaLabel }}">{{ if .V.Slide }}<span class="sky-cardstack-page" data-total="{{ .V.PageTotal }}"></span>{{ end }}{{ c.Label }}</label>{{ end }}{{ end }}{{ end }}{{ if .V.DeckArrows }}<button type="button" class="sky-cardstack-arrow sky-cardstack-arrow--prev" data-cardstack-prev aria-label="上一页">‹</button><button type="button" class="sky-cardstack-arrow sky-cardstack-arrow--next" data-cardstack-next aria-label="下一页">›</button>{{ end }}</div><label class="sky-cardstack-scrim"><input type="radio" class="sky-cardstack-close" name="sky-cardstack-zoom" id="sky-cs-close-{{ .NodeID }}" aria-label="关闭放大的卡片"></label><label class="sky-cardstack-close-btn" for="sky-cs-close-{{ .NodeID }}" aria-label="关闭">✕</label></div>
