<div class="{{ .Classes }} wp-cardstack{{ if .V.Collection }} wp-cardstack--collection{{ end }}{{ if .V.HasContent }} wp-cardstack--content{{ else }}{{ if not .V.Collection }} wp-cardstack--num{{ end }}{{ end }}"{{ if .V.Drag }} data-cardstack-drag tabindex="0" role="group" aria-label="可拖拽旋转的卡片环（左右方向键也可旋转）"{{ end }}{{ if .V.Deck }} data-cardstack-deck="{{ .V.DeckIndex }}"{{ if .V.DeckLoop }} data-cardstack-loop="1"{{ end }} tabindex="0" role="group" aria-label="可滑动切换的卡片堆叠（左右方向键也可切换）"{{ end }}{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}><div class="wp-cardstack-track" data-cardstack-track>{{ if .V.HasCardNodes }}{{ range _, group := .V.CardNodes }}<label class="wp-cardstack-card"><input type="radio" class="wp-cardstack-toggle" name="wp-cardstack-zoom" aria-label="放大这张卡片">{{ range _, n := group }}{{ include n.Template n }}{{ end }}</label>{{ end }}{{ else if .V.Collection }}{{ range _, c := .V.Cards }}<label class="wp-cardstack-card"><input type="radio" class="wp-cardstack-toggle" name="wp-cardstack-zoom" aria-label="{{ c.AriaLabel }}">{{ if c.HasImage }}<img class="wp-cardstack-img" src="{{ c.Image }}" alt="{{ c.Title }}" loading="lazy" decoding="async">{{ end }}{{ if c.HasTitle }}<h3 class="wp-cardstack-title">{{ c.Title }}</h3>{{ end }}{{ if c.HasText }}<p class="wp-cardstack-text">{{ c.Text }}</p>{{ end }}{{ if c.HasMeta }}<p class="wp-cardstack-meta">{{ c.Meta }}</p>{{ end }}{{ if c.HasHref }}<a class="wp-cardstack-link" href="{{ c.Href }}">查看详情</a>{{ end }}</label>{{ end }}{{ else if .V.HasContent }}{{ range _, child := .Children }}<label class="wp-cardstack-card"><input type="radio" class="wp-cardstack-toggle" name="wp-cardstack-zoom" aria-label="放大这张卡片">{{ include child.Template child }}</label>{{ end }}{{ else }}{{ range _, c := .V.Cards }}<label class="wp-cardstack-card"><input type="radio" class="wp-cardstack-toggle" name="wp-cardstack-zoom" aria-label="{{ c.AriaLabel }}">{{ c.Label }}</label>{{ end }}{{ end }}</div><label class="wp-cardstack-scrim"><input type="radio" class="wp-cardstack-close" name="wp-cardstack-zoom" id="wp-cs-close-{{ .NodeID }}" aria-label="关闭放大的卡片"></label><label class="wp-cardstack-close-btn" for="wp-cs-close-{{ .NodeID }}" aria-label="关闭">✕</label></div>
