<form class="{{ .Classes }}" method="{{ .V.Method }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}{{ if .V.Action }} action="{{ .V.Action }}"{{ end }}>{{ range _, f := .V.Fields }}<div class="sky-form-field">{{ if f.Type == "checkbox" }}<label class="sky-form-check"><input type="checkbox" name="{{ f.Name }}"{{ if f.Required }} required{{ end }}> {{ f.Label }}</label>{{ else }}<label>{{ f.Label }}</label>{{ if f.Type == "textarea" }}<textarea name="{{ f.Name }}"{{ if f.Placeholder }} placeholder="{{ f.Placeholder }}"{{ end }}{{ if f.Required }} required{{ end }}></textarea>{{ else if f.Type == "select" }}<select name="{{ f.Name }}"{{ if f.Required }} required{{ end }}>{{ range _, opt := f.Options }}<option value="{{ opt }}">{{ opt }}</option>{{ end }}</select>{{ else }}<input type="{{ f.Type }}" name="{{ f.Name }}"{{ if f.Placeholder }} placeholder="{{ f.Placeholder }}"{{ end }}{{ if f.Required }} required{{ end }}>{{ end }}{{ end }}</div>{{ end }}<button type="submit" class="sky-form-submit">{{ .V.SubmitLabel }}</button></form>
