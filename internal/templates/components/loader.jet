<span class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} role="status" aria-live="polite" aria-label="{{ .V.AriaText }}">{{ if .V.Items }}{{ if .V.Wrap }}<span class="wp-loader-{{ .V.Self }}" aria-hidden="true">{{ range _, _ := .V.Items }}<i></i>{{ end }}</span>{{ else }}{{ range _, _ := .V.Items }}<i class="wp-loader-{{ .V.Self }}" aria-hidden="true"></i>{{ end }}{{ end }}{{ else }}<span class="wp-loader-{{ .V.Self }}" aria-hidden="true"></span>{{ end }}{{ if .V.Label }}<span class="wp-loader-label">{{ .V.Label }}</span>{{ end }}</span>
