<{{ .Tag }} class="{{ .Classes }}"{{ unsafe(.Attrs) }}>{{ if .ShapeTop }}<span class="wp-shape wp-shape-top"><svg viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true">{{ unsafe(.ShapeTop) }}</svg></span>{{ end }}{{ range _, child := .Children }}{{ include child.Template child }}{{ end }}{{ if .ShapeBottom }}<span class="wp-shape wp-shape-bottom"><svg viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true">{{ unsafe(.ShapeBottom) }}</svg></span>{{ end }}</{{ .Tag }}>