<div class="{{ .Classes }} sky-counter" {{ if not .V.CSSMode }}data-counter="1" data-start="{{ .V.StartData }}" data-end="{{ .V.EndData }}" data-decimals="{{ .V.DecimalsData }}" data-duration="{{ .V.DurationData }}"{{ end }}>{{ if .V.Prefix }}<span class="sky-counter-prefix">{{ .V.Prefix }}</span>{{ end }}<span class="sky-counter-value">{{ .V.Value }}</span>{{ if .V.Suffix }}<span class="sky-counter-suffix">{{ .V.Suffix }}</span>{{ end }}</div>{{ if .V.Label }}<div class="{{ .Classes }}-label sky-counter-label">{{ .V.Label }}</div>{{ end }}