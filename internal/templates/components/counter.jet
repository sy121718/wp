<div class="{{ .Classes }} wp-counter" data-counter="1" data-start="{{ .V.StartData }}" data-end="{{ .V.EndData }}" data-decimals="{{ .V.DecimalsData }}" data-duration="{{ .V.DurationData }}">{{ if .V.Prefix }}<span class="wp-counter-prefix">{{ .V.Prefix }}</span>{{ end }}<span class="wp-counter-value">{{ .V.Value }}</span>{{ if .V.Suffix }}<span class="wp-counter-suffix">{{ .V.Suffix }}</span>{{ end }}</div>{{ if .V.Label }}<div class="{{ .Classes }}-label wp-counter-label">{{ .V.Label }}</div>{{ end }}