<nav class="{{ .Classes }} wp-nav" aria-label="{{ .V.Label }}">{{ if .V.MobileCollapse }}<input type="checkbox" class="wp-nav-toggle" id="{{ .V.ToggleID }}" hidden><label class="wp-nav-burger" for="{{ .V.ToggleID }}">{{ .V.ToggleLabel }}</label>{{ end }}<ul class="wp-nav-list">{{ range _, it := .V.Items }}<li class="wp-nav-item{{ if it.HasChildren }} has-children{{ end }}{{ if it.Current }} is-current{{ end }}"><a href="{{ it.URL }}"{{ if it.Target == "blank" }} target="_blank" rel="noopener"{{ end }}{{ if it.Current }} aria-current="page"{{ end }}>{{ it.Label }}</a>{{ if it.HasChildren }}<ul class="wp-nav-sub">{{ range _, c := it.Children }}<li class="wp-nav-sub-item{{ if c.Current }} is-current{{ end }}"><a href="{{ c.URL }}"{{ if c.Target == "blank" }} target="_blank" rel="noopener"{{ end }}{{ if c.Current }} aria-current="page"{{ end }}>{{ c.Label }}</a></li>{{ end }}</ul>{{ end }}</li>{{ end }}</ul></nav>