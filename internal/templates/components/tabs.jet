<div class="{{ .Classes }} wp-tabs{{ if .V.Vertical }} wp-tabs-vertical{{ end }}">{{ range _, t := .V.Tabs }}<input type="radio" class="wp-tabs-radio" id="{{ t.ID }}" name="{{ t.Name }}"{{ if t.Checked }} checked{{ end }}>{{ end }}<div class="wp-tabs-nav" role="tablist">{{ range _, t := .V.Tabs }}<label for="{{ t.ID }}" role="tab">{{ t.Label }}</label>{{ end }}</div>{{ range i, child := .Children }}<div class="wp-tab-panel" data-index="{{ i }}">{{ include child.Template child }}</div>{{ end }}</div>