<div class="{{ .Classes }} wp-tabs{{ if .V.Vertical }} wp-tabs-vertical{{ end }}">{{ range _, t := .V.Tabs }}{{ unsafe(t.RadioHTML) }}{{ end }}<div class="wp-tabs-nav" role="tablist">{{ range _, t := .V.Tabs }}{{ unsafe(t.LabelHTML) }}{{ end }}</div>{{ range i, child := .Children }}<div class="wp-tab-panel" data-index="{{ i }}">{{ include child.Template child }}</div>{{ end }}</div>