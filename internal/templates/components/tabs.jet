<div class="{{ .Classes }} sky-tabs{{ if .V.Vertical }} sky-tabs-vertical{{ end }}"><div class="sky-tabs-nav">{{ range idx, t := .V.Tabs }}<input type="radio" class="sky-tabs-radio" id="{{ t.ID }}" name="{{ t.Name }}"{{ if t.Checked }} checked{{ end }} aria-controls="sky-tabs-panel-{{ .NodeID }}-{{ idx }}"><label class="sky-tabs-tab" for="{{ t.ID }}" aria-hidden="true">{{ t.Label }}</label>{{ end }}</div>{{ range i, child := .Children }}<div class="sky-tab-panel" id="sky-tabs-panel-{{ .NodeID }}-{{ i }}" data-index="{{ i }}" tabindex="0">{{ include child.Template child }}</div>{{ end }}</div>