{{ if .V.Visible }}<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.IsCarousel }}<div class="gallery-carousel" {{ unsafe(.V.CarouselAttr) }}><div class="gallery-track">{{ range _, item := .V.Items }}<div class="gallery-slide">{{ unsafe(item) }}</div>{{ end }}</div>{{ if .V.Arrows }}<button class="gallery-prev" aria-label="上一张" type="button">‹</button><button class="gallery-next" aria-label="下一张" type="button">›</button>{{ end }}{{ if .V.Dots }}<div class="gallery-dots" aria-hidden="true"></div>{{ end }}</div>{{ else }}{{ range _, item := .V.Items }}{{ unsafe(item) }}{{ end }}{{ end }}</div>{{ end }}