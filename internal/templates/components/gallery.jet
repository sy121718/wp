{{ if .V.Visible }}<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.IsCarousel }}<div class="gallery-carousel" {{ unsafe(.V.CarouselAttr) }}><div class="gallery-track">{{ range _, item := .V.Items }}<div class="gallery-slide">{{ if item.HasFigure }}<figure>{{ end }}{{ if item.IsLightbox }}<a href="{{ item.URL }}" data-lightbox="wp-g-"><img class="gi" src="{{ item.URL }}" loading="lazy" decoding="async" alt="{{ item.Alt }}"></a>{{ else if item.IsLink }}<a href="{{ item.Href }}"><img class="gi" src="{{ item.URL }}" loading="lazy" decoding="async" alt="{{ item.Alt }}"></a>{{ else }}<img class="gi" src="{{ item.URL }}" loading="lazy" decoding="async" alt="{{ item.Alt }}">{{ end }}{{ if item.HasFigure }}<figcaption>{{ item.Caption }}</figcaption></figure>{{ end }}</div>{{ end }}</div>{{ if .V.Arrows }}<button class="gallery-prev" aria-label="上一张" type="button">‹</button><button class="gallery-next" aria-label="下一张" type="button">›</button>{{ end }}{{ if .V.Dots }}<div class="gallery-dots" aria-hidden="true"></div>{{ end }}</div>{{ else }}{{ range _, item := .V.Items }}{{ if item.HasFigure }}<figure>{{ end }}{{ if item.IsLightbox }}<a href="{{ item.URL }}" data-lightbox="wp-g-"><img class="gi" src="{{ item.URL }}" loading="lazy" decoding="async" alt="{{ item.Alt }}"></a>{{ else if item.IsLink }}<a href="{{ item.Href }}"><img class="gi" src="{{ item.URL }}" loading="lazy" decoding="async" alt="{{ item.Alt }}"></a>{{ else }}<img class="gi" src="{{ item.URL }}" loading="lazy" decoding="async" alt="{{ item.Alt }}">{{ end }}{{ if item.HasFigure }}<figcaption>{{ item.Caption }}</figcaption></figure>{{ end }}{{ end }}{{ end }}</div>{{ end }}