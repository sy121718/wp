<{{ .Tag }} class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}{{ unsafe(.Attrs) }}>{{ if .IconPrefix }}{{ if .Props.Icon.Source == "media" }}<img class="bt-icon" src="{{ unsafe(.IconPrefix) }}" alt="" style="width:{{ if .Props.Icon.Size }}{{ .Props.Icon.Size }}{{ else }}1em{{ end }};height:{{ if .Props.Icon.Size }}{{ .Props.Icon.Size }}{{ else }}1em{{ end }}">{{ else }}<svg class="bt-icon{{ if .Props.Icon.HoverShift }} bt-icon-shift{{ end }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ if .Props.Icon.Size }}{{ .Props.Icon.Size }}{{ else }}1em{{ end }}" height="{{ if .Props.Icon.Size }}{{ .Props.Icon.Size }}{{ else }}1em{{ end }}" aria-hidden="true">{{ unsafe(.IconPrefix) }}</svg>{{ end }}{{ end }}<span class="bt-text">{{ .Text }}</span>{{ if .IconSuffix }}{{ if .Props.Icon.Source == "media" }}<img class="bt-icon" src="{{ unsafe(.IconSuffix) }}" alt="" style="width:{{ if .Props.Icon.Size }}{{ .Props.Icon.Size }}{{ else }}1em{{ end }};height:{{ if .Props.Icon.Size }}{{ .Props.Icon.Size }}{{ else }}1em{{ end }}">{{ else }}<svg class="bt-icon{{ if .Props.Icon.HoverShift }} bt-icon-shift{{ end }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="{{ if .Props.Icon.Size }}{{ .Props.Icon.Size }}{{ else }}1em{{ end }}" height="{{ if .Props.Icon.Size }}{{ .Props.Icon.Size }}{{ else }}1em{{ end }}" aria-hidden="true">{{ unsafe(.IconSuffix) }}</svg>{{ end }}{{ end }}</{{ .Tag }}>