{{ if .V.IsInset }}<div class="{{ .Classes }}">{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}<span class="dt-line"></span>{{ if .V.IsText }}<span class="dt-inset dt-inset-text">{{ .V.InsetText }}</span>{{ else }}<span class="dt-inset"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{{ unsafe(.V.InsetIconContent) }}</svg></span>{{ end }}<span class="dt-line"></span></div>{{ else }}<hr class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}/>{{ end }}