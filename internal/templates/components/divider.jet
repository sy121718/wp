{{ if .V.IsInset }}<div class="{{ .Classes }}">{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}<span class="dt-line"></span>{{ if .V.IsText }}<span class="dt-inset dt-inset-text">{{ .V.InsetText }}</span>{{ else }}<span class="dt-inset">{{ unsafe(.V.InsetIconHTML) }}</span>{{ end }}<span class="dt-line"></span></div>{{ else }}<hr class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}/>{{ end }}