<div class="{{ .Classes }} sky-countdown" data-countdown="1" data-target="{{ .V.TargetData }}" data-show-days="{{ .V.ShowDaysData }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ range _, u := .V.Units }}<span class="cd-item"><span class="cd-num" data-unit="{{ u.Unit }}">00</span><span class="cd-label">{{ u.Label }}</span></span>{{ if u.Sep }}<span class="cd-sep" aria-hidden="true">:</span>{{ end }}{{ end }}</div>
