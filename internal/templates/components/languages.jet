{{ if .V.HasLinks }}<nav class="{{ .Classes }} sky-lang"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} aria-label="{{ .V.Label }}"><ul class="sky-lang-list">{{ range _, it := .V.Items }}<li class="sky-lang-item{{ if it.Current }} is-current{{ end }}">{{ if it.Current }}<span class="sky-lang-current" lang="{{ it.Lang }}" aria-current="true">{{ it.Label }}</span>{{ else }}<a class="sky-lang-link" href="{{ it.Href }}" hreflang="{{ it.Lang }}" lang="{{ it.Lang }}">{{ it.Label }}</a>{{ end }}</li>{{ end }}</ul></nav>{{ end }}
