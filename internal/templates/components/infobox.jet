{{ if .V.HasLink }}{{ if .V.HasBtn }}<div class="{{ .Classes }} sky-infobox">{{ if .V.HasMedia }}<span class="sky-infobox-media"><img src="{{ .V.MediaSrc }}"{{ if .V.Class }} class="{{ .V.Class }}"{{ end }} loading="{{ if .V.IsEager }}eager{{ else }}lazy{{ end }}"{{ if .V.FetchHigh }} fetchpriority="high"{{ end }}{{ if .V.FetchLow }} fetchpriority="low"{{ end }} decoding="async" alt=""></span>{{ else if .V.HasIcon }}<span class="sky-infobox-icon">{{ if .V.IconSVG }}{{ unsafe(.V.IconSVG) }}{{ end }}</span>{{ end }}{{ if .V.Subtitle }}<span class="sky-infobox-subtitle">{{ .V.Subtitle }}</span>{{ end }}{{ if .V.Title }}<{{ .V.TitleTag }} class="sky-infobox-title">{{ .V.Title }}</{{ .V.TitleTag }}>{{ end }}{{ if .V.Text }}<div class="sky-infobox-text">{{ unsafe(.V.Text) }}</div>{{ end }}<a class="sky-infobox-btn" href="{{ .V.Link }}">{{ .V.BtnText }}</a></div>{{ else }}<a class="{{ .Classes }} sky-infobox" href="{{ .V.Link }}">{{ if .V.HasMedia }}<span class="sky-infobox-media"><img src="{{ .V.MediaSrc }}"{{ if .V.Class }} class="{{ .V.Class }}"{{ end }} loading="{{ if .V.IsEager }}eager{{ else }}lazy{{ end }}"{{ if .V.FetchHigh }} fetchpriority="high"{{ end }}{{ if .V.FetchLow }} fetchpriority="low"{{ end }} decoding="async" alt=""></span>{{ else if .V.HasIcon }}<span class="sky-infobox-icon">{{ if .V.IconSVG }}{{ unsafe(.V.IconSVG) }}{{ end }}</span>{{ end }}{{ if .V.Subtitle }}<span class="sky-infobox-subtitle">{{ .V.Subtitle }}</span>{{ end }}{{ if .V.Title }}<{{ .V.TitleTag }} class="sky-infobox-title">{{ .V.Title }}</{{ .V.TitleTag }}>{{ end }}{{ if .V.Text }}<div class="sky-infobox-text">{{ unsafe(.V.Text) }}</div>{{ end }}</a>{{ end }}{{ else }}<div class="{{ .Classes }} sky-infobox">{{ if .V.HasMedia }}<span class="sky-infobox-media"><img src="{{ .V.MediaSrc }}"{{ if .V.Class }} class="{{ .V.Class }}"{{ end }} loading="{{ if .V.IsEager }}eager{{ else }}lazy{{ end }}"{{ if .V.FetchHigh }} fetchpriority="high"{{ end }}{{ if .V.FetchLow }} fetchpriority="low"{{ end }} decoding="async" alt=""></span>{{ else if .V.HasIcon }}<span class="sky-infobox-icon">{{ if .V.IconSVG }}{{ unsafe(.V.IconSVG) }}{{ end }}</span>{{ end }}{{ if .V.Subtitle }}<span class="sky-infobox-subtitle">{{ .V.Subtitle }}</span>{{ end }}{{ if .V.Title }}<{{ .V.TitleTag }} class="sky-infobox-title">{{ .V.Title }}</{{ .V.TitleTag }}>{{ end }}{{ if .V.Text }}<div class="sky-infobox-text">{{ unsafe(.V.Text) }}</div>{{ end }}</div>{{ end }}