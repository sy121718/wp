<div class="{{ .Classes }} wp-slider" data-slider="{{ .V.DataSlider }}"{{ if .V.HasAutoplay }} data-autoplay="{{ .V.Autoplay }}"{{ end }}{{ if .V.Loop }} data-loop="1"{{ end }}><div class="wp-slider-track" data-track="1">{{ range i, child := .Children }}<div class="wp-slide" id="wp-slide-{{ .NodeID }}-{{ i }}">{{ include child.Template child }}</div>{{ end }}</div>{{ if .V.ShowArrows }}<button type="button" class="wp-slider-arrow wp-slider-prev" data-prev="1" aria-label="{{ .V.PrevLabel }}">‹</button><button type="button" class="wp-slider-arrow wp-slider-next" data-next="1" aria-label="{{ .V.NextLabel }}">›</button>{{ end }}{{ if .V.ShowDots }}<div class="wp-slider-dots">{{ range _, d := .V.Dots }}<a class="wp-slider-dot" href="#{{ d.Anchor }}" aria-label="{{ d.Label }}"></a>{{ end }}</div>{{ end }}</div>