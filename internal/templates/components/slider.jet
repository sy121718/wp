<div class="{{ .Classes }} wp-slider" data-slider="{{ .V.DataSlider }}"{{ if .V.HasAutoplay }} data-autoplay="{{ .V.Autoplay }}"{{ end }}{{ if .V.Loop }} data-loop="1"{{ end }}><div class="wp-slider-track" data-track="1">{{ range _, child := .Children }}<div class="wp-slide">{{ include child.Template child }}</div>{{ end }}</div>{{ if .V.ShowArrows }}<button type="button" class="wp-slider-arrow wp-slider-prev" data-prev="1" aria-label="上一张">‹</button><button type="button" class="wp-slider-arrow wp-slider-next" data-next="1" aria-label="下一张">›</button>{{ end }}{{ if .V.ShowDots }}<div class="wp-slider-dots" data-dots="1"></div>{{ end }}</div>