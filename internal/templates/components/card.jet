<article class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.HasImage }}<img src="{{ .V.ImageSrc }}"{{ if .V.Class }} class="{{ .V.Class }}"{{ end }} loading="{{ if .V.IsEager }}eager{{ else }}lazy{{ end }}"{{ if .V.FetchHigh }} fetchpriority="high"{{ end }}{{ if .V.FetchLow }} fetchpriority="low"{{ end }} decoding="async" alt="{{ .V.Title }}">{{ end }}<h3>{{ .V.Title }}</h3><div class="wp-card-text">{{ unsafe(.V.Text) }}</div>{{ if .V.HasButton }}<a class="wp-card-btn" href="{{ .V.ButtonLink }}">{{ .V.ButtonText }}</a>{{ end }}</article>
