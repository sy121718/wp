<table class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.HasCaption }}<caption>{{ .V.Caption }}</caption>{{ end }}{{ if .V.HasHeader }}<thead><tr>{{ range $h := .V.Headers }}<th>{{ $h }}</th>{{ end }}</tr></thead>{{ end }}{{ if .V.HasBody }}<tbody>{{ range $row := .V.Rows }}<tr>{{ range $cell := $row }}<td>{{ $cell }}</td>{{ end }}</tr>{{ end }}</tbody>{{ end }}</table>
