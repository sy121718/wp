<table class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.HasCaption }}<caption>{{ .V.Caption }}</caption>{{ end }}{{ if .V.HasHeader }}<thead><tr>{{ range _, h := .V.Headers }}<th scope="col">{{ h }}</th>{{ end }}</tr></thead>{{ end }}{{ if .V.HasBody }}<tbody>{{ range _, row := .V.Rows }}<tr>{{ range _, cell := row }}<td>{{ cell }}</td>{{ end }}</tr>{{ end }}</tbody>{{ end }}</table>
