{{ if .V.Subtitle }}<span class="sky-heading-sub">{{ .V.Subtitle }}</span>{{ end }}<{{ .V.Tag }} class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.Highlight }}<span class="sky-heading-highlight">{{ .V.Text }}</span>{{ else }}{{ if .V.Segments }}{{ range _, seg := .V.Segments }}<span class="sky-h-seg">{{ seg }}</span>{{ end }}{{ else }}{{ .V.Text }}{{ end }}{{ end }}</{{ .V.Tag }}>