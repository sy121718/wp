<div class="{{ .Classes }} sky-accordion{{ if .V.Borderless }} sky-accordion-borderless{{ end }}">{{ range i, item := .V.Items }}{{ child := .Children[i] }}<details class="sky-accordion-item"{{ if .V.OneOpen }} name="sky-acc-{{ .NodeID }}"{{ end }}{{ if item.Open }} open{{ end }}><summary class="sky-accordion-head">{{ item.Title }}</summary><div class="sky-accordion-body">{{ include child.Template child }}</div></details>{{ end }}</div>