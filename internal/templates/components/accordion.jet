<div class="{{ .Classes }} wp-accordion{{ if .V.Borderless }} wp-accordion-borderless{{ end }}"{{ if .V.OneOpen }} data-one-open="1"{{ end }}>{{ range i, item := .V.Items }}{{ child := .Children[i] }}<details class="wp-accordion-item"{{ if item.Open }} open{{ end }}><summary class="wp-accordion-head">{{ item.Title }}</summary><div class="wp-accordion-body">{{ include child.Template child }}</div></details>{{ end }}</div>