<div class="{{ .Classes }} wp-accordion{{ if .V.Borderless }} wp-accordion-borderless{{ end }}">{{ range i, item := .V.Items }}{{ child := .Children[i] }}<details class="wp-accordion-item"{{ if .V.OneOpen }} name="wp-acc-{{ .NodeID }}"{{ end }}{{ if item.Open }} open{{ end }}><summary class="wp-accordion-head">{{ item.Title }}</summary><div class="wp-accordion-body">{{ include child.Template child }}</div></details>{{ end }}</div>