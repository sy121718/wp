{* product.jet — core.product 商品详情组件（issue #6 / #8）：媒体区 + 信息区 + 规格选择器 *}
{* 构建期字段已静态填入；规格选择器只在「有规格维度且组合 ≥2」时输出（单变体不输出）。
   选择器是原生 radio + label：鼠标点选 / 触屏点按 / 键盘（Tab 进组、方向键切换）都可用，
   不依赖任何 JS（访客请求期零查库零脚本，不变量 1）。 *}
<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.HasMedia || .V.HasGallery }}<div class="sky-product-media">{{ if .V.HasMedia }}<img src="{{ .V.MediaURL }}" alt="{{ .V.Title }}" loading="{{ if .V.HasGallery }}lazy{{ else }}eager{{ end }}" decoding="async">{{ end }}{{ if .V.HasGallery }}<div class="sky-product-gallery">{{ range _, img := .V.Gallery }}<img src="{{ img.URL }}" alt="{{ img.Alt }}" loading="{{ if img.Eager }}eager{{ else }}lazy{{ end }}" decoding="async">{{ end }}</div>{{ end }}</div>{{ end }}<div class="sky-product-info">{{ if .V.HasTitle }}<{{ .V.TitleTag }} class="sky-product-title">{{ .V.Title }}</{{ .V.TitleTag }}>{{ end }}{{ if .V.HasSubtitle }}<p class="sky-product-subtitle">{{ .V.Subtitle }}</p>{{ end }}{{ if .V.HasPrice }}<div class="sky-product-price-row"><span class="sky-product-price">{{ .V.Price }}</span>{{ if .V.HasComparePrice }}<span class="sky-product-compare">{{ .V.ComparePrice }}</span>{{ end }}</div>{{ end }}{{ if .V.HasOptions }}{{ nodeID := .NodeID }}<div class="sky-product-options">{{ range _, g := .V.OptionGroups }}<fieldset class="sky-product-option"><legend>{{ g.Name }}</legend>{{ range idx, v := g.Values }}<input type="radio" class="sky-product-option-radio" id="sky-opt-{{ nodeID }}-{{ g.Key }}-{{ v.Key }}" name="sky-opt-{{ nodeID }}-{{ g.Key }}" value="{{ v.Key }}"{{ if idx == 0 }} checked{{ end }}><label class="sky-product-option-value" for="sky-opt-{{ nodeID }}-{{ g.Key }}-{{ v.Key }}">{{ v.Label }}</label>{{ end }}</fieldset>{{ end }}</div><div class="sky-product-variants">{{ range _, vo := .V.VariantOptions }}<div class="sky-product-variant"><span class="sky-product-variant-options">{{ vo.Labels }}</span><span class="sky-product-variant-price">{{ vo.Price }}</span>{{ if vo.ComparePrice }}<span class="sky-product-compare">{{ vo.ComparePrice }}</span>{{ end }}</div>{{ end }}</div>{{ end }}{{ if .V.HasDescription }}<div class="sky-product-description">{{ unsafe(.V.DescriptionHTML) }}</div>{{ end }}</div></div>
