{* product.jet — core.product 商品详情组件（issue #6）：媒体区 + 信息区，构建期字段已静态填入 *}
<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.HasMedia || .V.HasGallery }}<div class="sky-product-media">{{ if .V.HasMedia }}<img src="{{ .V.MediaURL }}" alt="{{ .V.Title }}" loading="{{ if .V.HasGallery }}lazy{{ else }}eager{{ end }}" decoding="async">{{ end }}{{ if .V.HasGallery }}<div class="sky-product-gallery">{{ range _, img := .V.Gallery }}<img src="{{ img.URL }}" alt="{{ img.Alt }}" loading="{{ if img.Eager }}eager{{ else }}lazy{{ end }}" decoding="async">{{ end }}</div>{{ end }}</div>{{ end }}<div class="sky-product-info">{{ if .V.HasTitle }}<{{ .V.TitleTag }} class="sky-product-title">{{ .V.Title }}</{{ .V.TitleTag }}>{{ end }}{{ if .V.HasSubtitle }}<p class="sky-product-subtitle">{{ .V.Subtitle }}</p>{{ end }}{{ if .V.HasPrice }}<div class="sky-product-price-row"><span class="sky-product-price">{{ .V.Price }}</span>{{ if .V.HasComparePrice }}<span class="sky-product-compare">{{ .V.ComparePrice }}</span>{{ end }}</div>{{ end }}{{ if .V.HasDescription }}<div class="sky-product-description">{{ unsafe(.V.DescriptionHTML) }}</div>{{ end }}</div></div>
