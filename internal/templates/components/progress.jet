<div class="{{ .Classes }} sky-progress" role="progressbar" aria-valuenow="{{ .V.ValueNow }}" aria-valuemax="{{ .V.ValueMax }}" aria-valuemin="0"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.HasLabel }}<span class="sky-progress-label">{{ .V.Label }}</span>{{ end }}<div class="sky-progress-track"><div class="sky-progress-bar"></div></div></div>
