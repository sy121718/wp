<div class="{{ .Classes }} sky-rating" role="img" aria-label="{{ .V.Label }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ range _, s := .V.Stars }}<span class="sky-star">{{ if s.Form == "full" }}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="{{ s.Points }}"/></svg>{{ else if s.Form == "half" }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><defs><clipPath id="sky-star-half"><rect x="0" y="0" width="12" height="24"/></clipPath></defs><polygon points="{{ s.Points }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><polygon points="{{ s.Points }}" fill="currentColor" clip-path="url(#sky-star-half)"/></svg>{{ else }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><polygon points="{{ s.Points }}"/></svg>{{ end }}</span>{{ end }}</div>
