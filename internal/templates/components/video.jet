<div class="{{ .Classes }} wp-video"><div class="wp-video-frame">{{ if .V.IsEmbed }}<iframe src="{{ .V.EmbedSrc }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy" title="视频"></iframe>{{ else }}<video{{ if .V.Poster }} poster="{{ .V.Poster }}"{{ end }}{{ if .V.Autoplay }} autoplay{{ end }}{{ if .V.Loop }} loop{{ end }}{{ if .V.Muted }} muted{{ end }}{{ if .V.Controls }} controls{{ end }} playsinline preload="{{ .V.Preload }}"><source src="{{ .V.Src }}"></video>{{ end }}</div></div>