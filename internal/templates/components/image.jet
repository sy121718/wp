{{ if .V.Caption }}<figure>{{ end }}{{ if .V.IsLightbox }}<a href="#wp-lb-{{ .V.NodeID }}"><img src="{{ .V.Src }}"{{ if .V.Class }} class="{{ .V.Class }}"{{ end }}{{ if .V.IsEager }} loading="eager"{{ else }} loading="lazy"{{ end }}{{ if .V.FetchHigh }} fetchpriority="high"{{ end }} decoding="async" alt="{{ .V.Alt }}"{{ if .V.Title }} title="{{ .V.Title }}"{{ end }}></a><div id="wp-lb-{{ .V.NodeID }}" class="wp-lightbox"><a href="#{{ .V.NodeID }}" class="wp-lightbox-close">×</a><img src="{{ .V.Src }}" alt=""></div>{{ else if .V.IsLink }}<a href="{{ .V.Link }}"{{ if .V.TargetBlank }} target="_blank"{{ end }}{{ if .V.RelNofollow }} rel="nofollow"{{ end }}{{ if .V.LinkID }} id="{{ .V.LinkID }}"{{ end }}><img src="{{ .V.Src }}"{{ if .V.Class }} class="{{ .V.Class }}"{{ end }}{{ if .V.IsEager }} loading="eager"{{ else }} loading="lazy"{{ end }}{{ if .V.FetchHigh }} fetchpriority="high"{{ end }} decoding="async" alt="{{ .V.Alt }}"{{ if .V.Title }} title="{{ .V.Title }}"{{ end }}></a>{{ else }}<img{{ if .V.ImgID }} id="{{ .V.ImgID }}"{{ end }} src="{{ .V.Src }}"{{ if .V.Class }} class="{{ .V.Class }}"{{ end }}{{ if .V.IsEager }} loading="eager"{{ else }} loading="lazy"{{ end }}{{ if .V.FetchHigh }} fetchpriority="high"{{ end }} decoding="async" alt="{{ .V.Alt }}"{{ if .V.Title }} title="{{ .V.Title }}"{{ end }}>{{ end }}{{ if .V.Caption }}<figcaption>{{ .V.Caption }}</figcaption></figure>{{ end }}