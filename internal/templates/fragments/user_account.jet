{* user_account.jet — 表单由片段渲染（静态产物烘不进访客域的 CSRF token）。 账号面板：已登录给入口，未登录给引导。
   提交目标仍是 user 模块的 POST 路由：无 JS 时原生提交整页跳转，链路完全一样。 *}
<div class="sky-user-form" data-fragment="accountPanel">
{{if .Notice}}<p class="sky-user-notice">{{ .Notice }}</p>{{end}}
{{if .LoggedIn}}
<p class="sky-user-note">{{ .Labels.LoggedIn }}</p>
<ul class="sky-user-links">
{{if .AccountURL}}<li><a href="{{ .AccountURL }}">{{ .Labels.AccountCenter }}</a>{{ .Labels.AccountHint }}</li>{{end}}
</ul>
<form class="sky-user-fields" method="post" action="/user/logout">
<input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
<button class="sky-user-submit sky-user-submit-quiet" type="submit">{{ .Labels.Logout }}</button>
</form>
{{else}}
<p class="sky-user-note">{{ .Labels.Guest }}</p>
{{if .LoginURL}}<p class="sky-user-alt"><a href="{{ .LoginURL }}">{{ .Labels.GoLogin }}</a></p>{{end}}
{{if .RegisterURL}}<p class="sky-user-alt">{{ .Labels.NoAccount }}<a href="{{ .RegisterURL }}">{{ .Labels.Register }}</a></p>{{end}}
{{end}}
</div>
