{* user_account_profile.jet — 账号资料（含身份概览）。
   由片段渲染：资料是每个访客各自的数据，且表单要带访客域的 CSRF token（静态产物烘不进去）。
   提交目标仍是 user 模块的 POST 路由：无 JS 时原生提交整页跳转，链路完全一样。 *}
<div class="sky-user-form" data-fragment="accountProfileForm">
{{if .Unavailable}}
<p class="sky-user-note">账号资料暂不可用，请稍后再试。</p>
{{else if .NeedLogin}}
<p class="sky-user-note">请先登录后再查看账号资料。</p>
{{if .LoginURL}}<p class="sky-user-alt"><a href="{{ .LoginURL }}">去登录</a></p>{{end}}
{{else}}
{{if not .CSRFToken}}<p class="sky-user-error">会话未就绪，请刷新页面后重试。</p>{{end}}
<dl class="sky-user-meta">
<dt>用户名</dt><dd>{{ .Account.Username }}</dd>
<dt>邮箱</dt><dd>{{ .Account.Email }} {{if .Account.EmailVerified}}<span class="sky-user-tag">已验证</span>{{else}}<span class="sky-user-tag">未验证</span>{{end}}</dd>
<dt>注册时间</dt><dd>{{ .Account.RegisteredAtText }}</dd>
<dt>上次登录</dt><dd>{{ .Account.LastLoginTimeText }}{{if .Account.LastLoginIP}} · {{ .Account.LastLoginIP }}{{end}}</dd>
</dl>
<form class="sky-user-fields" method="post" action="/user/account/profile" novalidate>
<input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
{{if .Next}}<input type="hidden" name="next" value="{{ .Next }}">{{end}}
<div class="sky-user-grid">
<label class="sky-user-field">昵称
<input class="sky-user-input" type="text" name="nickname" value="{{ .Account.Nickname }}" autocomplete="nickname">
</label>
<label class="sky-user-field">性别
<select class="sky-user-input" name="gender">
<option value="0"{{if .Account.Gender == 0}} selected{{end}}>未填写</option>
<option value="1"{{if .Account.Gender == 1}} selected{{end}}>男</option>
<option value="2"{{if .Account.Gender == 2}} selected{{end}}>女</option>
</select>
</label>
<label class="sky-user-field">名
<input class="sky-user-input" type="text" name="firstName" value="{{ .Account.FirstName }}" autocomplete="given-name">
</label>
<label class="sky-user-field">姓
<input class="sky-user-input" type="text" name="lastName" value="{{ .Account.LastName }}" autocomplete="family-name">
</label>
<label class="sky-user-field">生日
<input class="sky-user-input" type="date" name="birthday" value="{{ .Account.Birthday }}" autocomplete="bday">
</label>
<label class="sky-user-field">电话
<input class="sky-user-input" type="tel" name="phone" value="{{ .Account.Phone }}" autocomplete="tel">
</label>
<label class="sky-user-field">个人主页
<input class="sky-user-input" type="url" name="website" value="{{ .Account.Website }}" placeholder="https://">
</label>
<label class="sky-user-field">公司 / 组织
<input class="sky-user-input" type="text" name="company" value="{{ .Account.Company }}" autocomplete="organization">
</label>
<label class="sky-user-field">国家 / 地区
<input class="sky-user-input" type="text" name="country" value="{{ .Account.Country }}" autocomplete="country-name">
</label>
<label class="sky-user-field">省 / 州
<input class="sky-user-input" type="text" name="province" value="{{ .Account.Province }}" autocomplete="address-level1">
</label>
<label class="sky-user-field">城市
<input class="sky-user-input" type="text" name="city" value="{{ .Account.City }}" autocomplete="address-level2">
</label>
<label class="sky-user-field">邮编
<input class="sky-user-input" type="text" name="postcode" value="{{ .Account.Postcode }}" autocomplete="postal-code">
</label>
</div>
<label class="sky-user-field">地址
<input class="sky-user-input" type="text" name="address" value="{{ .Account.Address }}" autocomplete="street-address">
</label>
<label class="sky-user-field">简介
<textarea class="sky-user-input sky-user-textarea" name="bio">{{ .Account.Bio }}</textarea>
</label>
<button class="sky-user-submit" type="submit">保存资料</button>
</form>
{{end}}
</div>
