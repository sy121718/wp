{* user_login.jet — 表单由片段渲染（静态产物烘不进访客域的 CSRF token）。 登录表单。
   提交目标仍是 user 模块的 POST 路由：无 JS 时原生提交整页跳转，链路完全一样。 *}
<div class="sky-user-form" data-fragment="loginForm">
{{if .Notice}}<p class="sky-user-notice">{{ .Notice }}</p>{{end}}
{{if not .CSRFToken}}<p class="sky-user-error">{{ .Labels.SessionNotReady }}</p>{{end}}
<form class="sky-user-fields" method="post" action="/user/login" novalidate>
<input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
{{if .Next}}<input type="hidden" name="next" value="{{ .Next }}">{{end}}
<label class="sky-user-field">{{ .Labels.Identity }}
<input class="sky-user-input" type="text" name="account" required autocomplete="username">
</label>
<label class="sky-user-field">{{ .Labels.Password }}
<input class="sky-user-input" type="password" name="password" required autocomplete="current-password">
</label>
<label class="sky-user-check"><input type="checkbox" name="remember" value="1"> {{ .Labels.Remember }}</label>
<button class="sky-user-submit" type="submit">{{ .Labels.Submit }}</button>
</form>
{{if .RegisterURL}}<p class="sky-user-alt">{{ .Labels.NoAccount }}<a href="{{ .RegisterURL }}">{{ .Labels.Register }}</a></p>{{end}}
{{if .ForgotURL}}<p class="sky-user-alt"><a href="{{ .ForgotURL }}">{{ .Labels.Forgot }}</a></p>{{end}}
</div>
