{* user_account_password.jet — 修改密码。
   由片段渲染只为一件东西：访客域的 CSRF token（静态产物烘不进去）。
   提交目标仍是 /user/account/password：那条链路带着旧密码校验与「撤销全部会话」。 *}
<div class="sky-user-form" data-fragment="accountPasswordForm">
{{if .NeedLogin}}
<p class="sky-user-note">请先登录后再修改密码。</p>
{{if .LoginURL}}<p class="sky-user-alt"><a href="{{ .LoginURL }}">去登录</a></p>{{end}}
{{else}}
{{if not .CSRFToken}}<p class="sky-user-error">会话未就绪，请刷新页面后重试。</p>{{end}}
<form class="sky-user-fields" method="post" action="/user/account/password" novalidate>
<input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
<label class="sky-user-field">当前密码
<input class="sky-user-input" type="password" name="oldPassword" required autocomplete="current-password">
</label>
<label class="sky-user-field">新密码
<input class="sky-user-input" type="password" name="newPassword" required autocomplete="new-password">
</label>
<p class="sky-user-alt">至少 8 位。修改成功后所有设备都会退出登录。</p>
<button class="sky-user-submit" type="submit">修改密码</button>
</form>
{{end}}
</div>
