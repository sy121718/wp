{* user_account_password.jet — 修改密码。
   由片段渲染只为一件东西：访客域的 CSRF token（静态产物烘不进去）。
   提交目标仍是 /user/account/password：那条链路带着旧密码校验与「撤销全部会话」。 *}
<div class="sky-user-form" data-fragment="accountPasswordForm">
{{if .NeedLogin}}
<p class="sky-user-note">{{ .Labels.NeedLogin }}</p>
{{if .LoginURL}}<p class="sky-user-alt"><a href="{{ .LoginURL }}">{{ .Labels.GoLogin }}</a></p>{{end}}
{{else}}
{{if not .CSRFToken}}<p class="sky-user-error">{{ .Labels.SessionNotReady }}</p>{{end}}
<form class="sky-user-fields" method="post" action="/user/account/password" novalidate>
<input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
<label class="sky-user-field">{{ .Labels.Current }}
<input class="sky-user-input" type="password" name="oldPassword" required autocomplete="current-password">
</label>
<label class="sky-user-field">{{ .Labels.NewPassword }}
<input class="sky-user-input" type="password" name="newPassword" required autocomplete="new-password">
</label>
<p class="sky-user-alt">{{ .Labels.Hint }}</p>
<button class="sky-user-submit" type="submit">{{ .Labels.Submit }}</button>
</form>
{{end}}
</div>
