{* order_detail.jet — 访客订单明细片段（BIZ-1 访问面）。

   只显示「这一单是什么」：订单项快照 + 状态流转链 + 金额分解 + 收货地址。
   金额一律由服务端算好成展示串（模板不做算术）—— 同一份数字在多处各算一遍，
   迟早会出现两个页面显示不同的合计。

   归属：这一层不做校验。片段把访客身份交给 order 模块的 VisitorOrderReader，
   由它在 SQL 条件里收口（别人的单与不存在的单返回同一句话，
   区分开来就是一个订单号探测器）。 *}
{{items := .Items}}
{{logs := .Logs}}
<div class="sky-order-detail" data-fragment="{{ .FragmentType }}">
{{if .Notice}}
<p class="sky-orders-notice">{{ .Notice }}</p>
{{else if .NeedLogin}}
<p class="sky-orders-notice">登录后可以查看订单明细。</p>
{{if .LoginURL}}<a class="sky-orders-action" href="{{ .LoginURL }}">去登录</a>{{end}}
{{else}}
<div class="sky-order-meta">
<span class="sky-orders-no">{{ .OrderNo }}</span>
<span class="sky-orders-status">{{ .StatusLabel }}</span>
<span class="sky-orders-time">{{ .TimeLabel }}</span>
</div>
<ul class="sky-order-lines">
{{range _, it := items}}
<li class="sky-order-line">
<span class="sky-order-line-name">{{ it.ProductName }}{{if it.VariantLabel}}<span class="sky-order-line-variant">{{ it.VariantLabel }}</span>{{end}}</span>
<span class="sky-order-line-sku">{{ it.SKU }}</span>
<span class="sky-order-line-price">{{ it.UnitPrice }} × {{ it.Quantity }}</span>
<span class="sky-order-line-total">{{ it.LineTotal }}</span>
</li>
{{end}}
</ul>
<p class="sky-order-sum">
<span>商品合计 {{ .TotalLabel }}</span>
<span>优惠 {{ .DiscountLabel }}</span>
<span>运费 {{ .ShippingLabel }}</span>
</p>
{{if .PayMethod}}<p class="sky-order-pay">支付方式：{{ .PayMethod }}{{if .PaidAtLabel}}（{{ .PaidAtLabel }}）{{end}}</p>{{end}}
{{if .Address}}<p class="sky-order-address">收货地址：{{ .Address }}</p>{{end}}
{{if .Remark}}<p class="sky-order-remark">备注：{{ .Remark }}</p>{{end}}
{{if logs}}
<ol class="sky-order-logs">
{{range _, lg := logs}}
<li class="sky-order-log">
<span class="sky-order-log-time">{{ lg.TimeLabel }}</span>
<span class="sky-order-log-state">{{ if lg.FromLabel }}{{ lg.FromLabel }} → {{ end }}{{ lg.ToLabel }}</span>
{{if lg.OperatorName}}<span class="sky-order-log-op">{{ lg.OperatorName }}</span>{{end}}
{{if lg.Remark}}<span class="sky-order-log-remark">{{ lg.Remark }}</span>{{end}}
</li>
{{end}}
</ol>
{{end}}
{{end}}
</div>
