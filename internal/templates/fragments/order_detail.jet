{* order_detail.jet — 访客订单明细片段（BIZ-1 访问面）。 *}
{{items := .Items}}
{{logs := .Logs}}
{{returns := .Returns}}
{{labels := .Labels}}
<div class="sky-order-detail" data-fragment="{{ .FragmentType }}">
{{if .Notice}}
<p class="sky-orders-notice">{{ .Notice }}</p>
{{else if .NeedLogin}}
<p class="sky-orders-notice">{{ labels.NeedLogin }}</p>
{{if .LoginURL}}<a class="sky-orders-action" href="{{ .LoginURL }}">{{ labels.GoLogin }}</a>{{end}}
{{else}}
{{if .NoticeOK}}<p class="sky-return-ok">{{ .NoticeOK }}</p>{{end}}
<div class="sky-order-meta">
<span class="sky-orders-no">{{ .OrderNo }}</span>
<span class="sky-orders-status" role="status" aria-label="{{ .StatusLabel }}">{{ .StatusLabel }}</span>
<span class="sky-orders-time">{{ .TimeLabel }}</span>
</div>
<ul class="sky-order-lines">
{{range _, it := items}}
<li class="sky-order-line">
<span class="sky-order-line-name">{{ it.ProductName }}{{if it.VariantLabel}}<span class="sky-order-line-variant">{{ it.VariantLabel }}</span>{{end}}</span>
<span class="sky-order-line-sku">{{ it.SKU }}</span>
<span class="sky-order-line-price">{{ it.UnitPrice }} × {{ it.Quantity }}</span>
<span class="sky-order-line-total">{{ it.LineTotal }}</span>
</li>
{{end}}
</ul>
<p class="sky-order-sum">
<span>{{ labels.SubtotalGoods }} {{ .TotalLabel }}</span>
<span>{{ labels.Discount }} {{ .DiscountLabel }}</span>
<span>{{ labels.Shipping }} {{ .ShippingLabel }}</span>
</p>
{{if .PayMethod}}<p class="sky-order-pay">{{ labels.PayMethod }}{{ .PayMethod }}{{if .PaidAtLabel}}（{{ .PaidAtLabel }}）{{end}}</p>{{end}}
{{if .Address}}<p class="sky-order-address">{{ labels.ShippingAddr }}{{ .Address }}</p>{{end}}
{{if .Remark}}<p class="sky-order-remark">{{ labels.Remark }}{{ .Remark }}</p>{{end}}
{{if logs}}
<ol class="sky-order-logs">
{{range _, lg := logs}}
<li class="sky-order-log">
<span class="sky-order-log-time">{{ lg.TimeLabel }}</span>
<span class="sky-order-log-state">{{ if lg.FromLabel }}{{ lg.FromLabel }} → {{ end }}{{ lg.ToLabel }}</span>
{{if lg.OperatorName}}<span class="sky-order-log-op">{{ lg.OperatorName }}</span>{{end}}
{{if lg.Remark}}<span class="sky-order-log-remark">{{ lg.Remark }}</span>{{end}}
</li>
{{end}}
</ol>
{{end}}

{{if returns}}
<div class="sky-returns">
<p class="sky-returns-title">{{ labels.ReturnsTitle }}</p>
<ul class="sky-returns-list">
{{range _, rt := returns}}
<li class="sky-return-item">
<span class="sky-return-no">{{ rt.ReturnNo }}</span>
<span class="sky-orders-status" role="status" aria-label="{{ rt.StatusLabel }}">{{ rt.StatusLabel }}</span>
<span class="sky-order-line-total">{{ rt.RefundLabel }}</span>
<span class="sky-orders-time">{{ rt.TimeLabel }}</span>
{{if rt.Reason}}<span class="sky-return-reason">{{ rt.Reason }}</span>{{end}}
</li>
{{end}}
</ul>
</div>
{{end}}

{{if .CanRequestReturn}}
<form class="sky-return-form" method="post" action="/_fragments/{{ .ReturnActionURL }}" hx-post="/_fragments/{{ .ReturnActionURL }}" hx-target="closest .sky-order-detail" hx-swap="outerHTML">
<input type="hidden" name="projectId" value="{{ .ProjectID }}">
<input type="hidden" name="orderId" value="{{ .OrderID }}">
<input type="hidden" name="requestId" value="{{ .ReturnRequestID }}">
<p class="sky-returns-title">{{ labels.ReturnApply }}</p>
<p class="sky-order-pay">{{ labels.ReturnHint }}</p>
<ul class="sky-return-lines">
{{range _, it := items}}
{{if it.Returnable}}
<li class="sky-return-line">
<span class="sky-order-line-name">{{ it.ProductName }}{{if it.VariantLabel}}<span class="sky-order-line-variant">{{ it.VariantLabel }}</span>{{end}}</span>
<span class="sky-orders-time">{{ it.ReturnQtyHint }}</span>
<input type="hidden" name="orderItemId" value="{{ it.OrderItemID }}">
<input class="sky-return-qty" type="number" name="quantity" min="0" max="{{ it.Returnable }}" step="1" inputmode="numeric" placeholder="{{ labels.ReturnQtyPlaceholder }}" aria-label="{{ labels.ReturnQtyAria }}">
</li>
{{end}}
{{end}}
</ul>
<label class="sky-return-label">{{ labels.ReturnReason }}
<textarea class="sky-return-reason-input" name="reason" rows="2" maxlength="200" required placeholder="{{ labels.ReturnReasonPlaceholder }}"></textarea>
</label>
<button class="sky-return-submit" type="submit">{{ labels.ReturnSubmit }}</button>
</form>
{{else}}
{{if not returns}}<p class="sky-order-pay">{{ labels.NoReturnable }}</p>{{end}}
{{end}}
{{end}}
</div>
