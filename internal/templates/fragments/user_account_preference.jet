{* user_account_preference.jet — 账号偏好（分页 / 可见性 / 时区 / 通知）。
   由片段渲染：偏好是每个访客各自的数据，且表单要带访客域的 CSRF token。
   提交目标仍是 /user/account/preference：无 JS 时原生提交整页跳转。 *}
<div class="sky-user-form" data-fragment="accountPreferenceForm">
{{if .Unavailable}}
<p class="sky-user-note">{{ .Labels.Unavailable }}</p>
{{else if .NeedLogin}}
<p class="sky-user-note">{{ .Labels.NeedLogin }}</p>
{{if .LoginURL}}<p class="sky-user-alt"><a href="{{ .LoginURL }}">{{ .Labels.GoLogin }}</a></p>{{end}}
{{else}}
{{if not .CSRFToken}}<p class="sky-user-error">{{ .Labels.SessionNotReady }}</p>{{end}}
<form class="sky-user-fields" method="post" action="/user/account/preference" novalidate>
<input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
{{if .Next}}<input type="hidden" name="next" value="{{ .Next }}">{{end}}
<div class="sky-user-grid">
<label class="sky-user-field">{{ .Labels.PageSize }}
<input class="sky-user-input" type="number" name="pageSize" min="1" max="200" value="{{ .Account.PageSize }}">
</label>
<label class="sky-user-field">{{ .Labels.Visibility }}
<select class="sky-user-input" name="profileVisibility">
<option value="public"{{if .Account.ProfileVisibility == "public"}} selected{{end}}>{{ .Labels.VisibilityPublic }}</option>
<option value="members"{{if .Account.ProfileVisibility == "members"}} selected{{end}}>{{ .Labels.VisibilityMembers }}</option>
<option value="private"{{if .Account.ProfileVisibility == "private"}} selected{{end}}>{{ .Labels.VisibilityPrivate }}</option>
</select>
</label>
<label class="sky-user-field">{{ .Labels.Timezone }}
<input class="sky-user-input" type="text" name="timezone" value="{{ .Account.Timezone }}" placeholder="Asia/Shanghai">
</label>
</div>
<label class="sky-user-check"><input type="checkbox" name="emailNotify" value="1"{{if .Account.EmailNotify}} checked{{end}}> {{ .Labels.EmailNotify }}</label>
<label class="sky-user-check"><input type="checkbox" name="smsNotify" value="1"{{if .Account.SmsNotify}} checked{{end}}> {{ .Labels.SmsNotify }}</label>
<label class="sky-user-check"><input type="checkbox" name="showOnline" value="1"{{if .Account.ShowOnline}} checked{{end}}> {{ .Labels.ShowOnline }}</label>
<button class="sky-user-submit" type="submit">{{ .Labels.Save }}</button>
</form>
{{end}}
</div>
