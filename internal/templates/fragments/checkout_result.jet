{* checkout_result.jet — 结算结果。
   两态刻意都保留订单号：Paid 为假表示**订单已经建好、钱没收到**（支付通道失败），
   不是「下单失败」。把单号给到访客，他能凭它继续付款或找客服；
   换成一句「下单失败」，客户手里就什么都不剩，而这笔订单其实已经扣过库存了。 *}
<div class="sky-checkout-result{{ if .Paid }} is-paid{{ else }} is-pending{{ end }}" data-fragment="checkout" role="status">
{{ if .Paid }}
<p class="sky-checkout-title">{{ .Labels.TitlePaid }}</p>
{{ else }}
<p class="sky-checkout-title">{{ .Labels.TitlePending }}</p>
{{ end }}
<p class="sky-checkout-order">{{ .Labels.OrderNoPrefix }}{{ .OrderNo }}</p>
<p class="sky-checkout-total">{{ .Labels.TotalPrefix }}{{ .TotalLabel }}</p>
{{ if .PaymentError }}
<p class="sky-checkout-error">{{ .PaymentError }}</p>
{{ end }}
{{ if .AccountMailed }}
<p class="sky-checkout-account">{{ .AccountNote }}</p>
{{ end }}
</div>
