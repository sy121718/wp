{* order_list.jet — 访客订单列表片段（BIZ-1 访问面）。 *}
{{items := .Items}}
{{tabs := .Tabs}}
{{labels := .Labels}}
<div class="sky-orders" data-fragment="{{ .FragmentType }}" data-project="{{ .ProjectID }}">
{{if .Notice}}
<p class="sky-orders-notice">{{ .Notice }}</p>
{{else if .NeedLogin}}
<p class="sky-orders-notice">{{ labels.NeedLogin }}</p>
{{if .LoginURL}}<a class="sky-orders-action" href="{{ .LoginURL }}">{{ labels.GoLogin }}</a>{{end}}
{{else}}
{{if tabs}}
<nav class="sky-orders-tabs" aria-label="{{ labels.TabsAria }}">
{{range _, t := tabs}}
{{if t.FragmentURL}}<a class="sky-orders-tab{{if t.Active}} is-active{{end}}" href="{{ t.URL }}" hx-get="{{ t.FragmentURL }}" hx-target="closest .sky-orders" hx-swap="outerHTML">{{ t.Label }}</a>
{{else}}<span class="sky-orders-tab{{if t.Active}} is-active{{end}}">{{ t.Label }}</span>
{{end}}
{{end}}
</nav>
{{end}}
{{if len(items) == 0}}
<p class="sky-orders-empty">{{ labels.Empty }}</p>
{{if .ShopURL}}<a class="sky-orders-action" href="{{ .ShopURL }}">{{ labels.GoShop }}</a>{{end}}
{{else}}
<ul class="sky-orders-list">
{{range _, o := items}}
<li class="sky-orders-item is-{{ o.Status }}">
<div class="sky-orders-head">
<span class="sky-orders-no">{{ o.OrderNo }}</span>
<span class="sky-orders-status" role="status" aria-label="{{ o.StatusLabel }}">{{ o.StatusLabel }}</span>
<span class="sky-orders-total">{{ o.TotalLabel }}</span>
<span class="sky-orders-time">{{ o.TimeLabel }}</span>
</div>
<button type="button" class="sky-orders-toggle" hx-get="{{ o.ItemURL }}" hx-target="next .sky-orders-detail" hx-swap="innerHTML">{{ labels.ViewDetail }}</button>
<div class="sky-orders-detail"></div>
</li>
{{end}}
</ul>
{{end}}
{{if .HasPrev || .HasNext}}
<nav class="sky-orders-pager" aria-label="{{ labels.PagerAria }}">
{{if .HasPrev}}<a class="sky-orders-page" href="{{ .PrevURL }}" hx-get="{{ .PrevFragmentURL }}" hx-target="closest .sky-orders" hx-swap="outerHTML">{{ labels.PrevPage }}</a>{{end}}
<span class="sky-orders-count">{{ .TotalCountLabel }}</span>
{{if .HasNext}}<a class="sky-orders-page" href="{{ .NextURL }}" hx-get="{{ .NextFragmentURL }}" hx-target="closest .sky-orders" hx-swap="outerHTML">{{ labels.NextPage }}</a>{{end}}
</nav>
{{end}}
{{end}}
</div>
