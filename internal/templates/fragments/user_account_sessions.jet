{* user_account_sessions.jet — 登录设备管理。
   由片段渲染：设备台账是每个访客各自的数据，且每个「踢出」按钮都要带访客域的 CSRF token。
   当前设备不给踢出按钮 —— 那个操作真正的名字是「退出登录」，另有入口。 *}
{{labels := .Labels}}
{{csrfToken := .CSRFToken}}
{{nextVal := .Next}}
<div class="sky-user-form" data-fragment="accountSessionsPanel">
{{if .Unavailable}}
<p class="sky-user-note">{{ labels.Unavailable }}</p>
{{else if .NeedLogin}}
<p class="sky-user-note">{{ labels.NeedLogin }}</p>
{{if .LoginURL}}<p class="sky-user-alt"><a href="{{ .LoginURL }}">{{ labels.GoLogin }}</a></p>{{end}}
{{else}}
{{if not csrfToken}}<p class="sky-user-error">{{ labels.SessionNotReady }}</p>{{end}}
{{if len(.Sessions) == 0}}
<p class="sky-user-note">{{ labels.Empty }}</p>
{{else}}
<ul class="sky-user-devices">
{{range _, s := .Sessions}}
<li class="sky-user-device">
<div class="sky-user-device-ua">{{if s.UserAgent}}{{ s.UserAgent }}{{else}}{{ labels.UnknownBrowser }}{{end}}{{if s.Current}} <span class="sky-user-tag">{{ labels.CurrentDevice }}</span>{{end}}</div>
<p class="sky-user-device-meta">{{if s.IP}}{{ s.IP }}{{else}}{{ labels.IPUnknown }}{{end}} · {{ labels.LastActive }} {{ s.LastActiveText }} · {{ labels.LoggedInAt }} {{ s.CreatedText }}</p>
{{if not s.Current}}
<form method="post" action="/user/account/sessions/revoke">
<input type="hidden" name="csrf_token" value="{{ csrfToken }}">
{{if nextVal}}<input type="hidden" name="next" value="{{ nextVal }}">{{end}}
<input type="hidden" name="id" value="{{ s.ID }}">
<button class="sky-user-submit sky-user-submit-quiet" type="submit">{{ labels.Revoke }}</button>
</form>
{{end}}
</li>
{{end}}
</ul>
<form method="post" action="/user/account/sessions/revoke-others">
<input type="hidden" name="csrf_token" value="{{ csrfToken }}">
{{if nextVal}}<input type="hidden" name="next" value="{{ nextVal }}">{{end}}
<button class="sky-user-submit sky-user-submit-quiet" type="submit">{{ labels.RevokeOthers }}</button>
</form>
{{end}}
{{end}}
</div>
