{* return_result.jet — 退货申请提交结果（BIZ-1，退货入库）。 *}
{{labels := .Labels}}
<div class="sky-return-result{{if .Notice}} is-error{{else}} is-ok{{end}}" data-fragment="returnRequest" role="status">
{{if .Notice}}
<p class="sky-return-title">{{ labels.TitleError }}</p>
<p class="sky-return-note">{{ .Notice }}</p>
{{else}}
<p class="sky-return-title">{{ labels.TitleSuccess }}</p>
<p class="sky-return-note">{{ .StatusLine }}</p>
<p class="sky-return-note">{{ .RefundNote }}</p>
{{if .Reason}}<p class="sky-return-note">{{ labels.ReasonPrefix }}{{ .Reason }}</p>{{end}}
{{end}}
</div>
