<!DOCTYPE html>
<html lang="{{ .Lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{ if .Title }}<title>{{ .Title }}</title>
{{ end }}{{ if .MetaDescription }}<meta name="description" content="{{ .MetaDescription }}">
{{ end }}{{ if .SEOHead }}{{ .SEOHead | unsafe }}
{{ end }}{{ if .GA4Head }}{{ .GA4Head | unsafe }}
{{ end }}{{ if .SearchConsoleHead }}{{ .SearchConsoleHead | unsafe }}
{{ end }}<style>
{{ if .ThemeVarsCSS }}{{ .ThemeVarsCSS | unsafe }}
{{ end }}{{ .CSS | unsafe }}
</style>
</head>
<body{{ if .BodyClass }} class="{{ .BodyClass | unsafe }}"{{ end }}>
{{ .HTML | unsafe }}
{{ if .EnhanceScript }}<script>{{ .EnhanceScript | unsafe }}</script>
{{ end }}</body>
</html>
