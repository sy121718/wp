<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{ if .Title }}<title>{{ .Title }}</title>
{{ end }}{{ if .MetaDescription }}<meta name="description" content="{{ .MetaDescription }}">
{{ end }}<style>
{{ if .ThemeVarsCSS }}{{ .ThemeVarsCSS | unsafe }}
{{ end }}{{ .CSS | unsafe }}
</style>
</head>
<body{{ if .BodyClass }} class="{{ .BodyClass | unsafe }}"{{ end }}>
{{ .HTML | unsafe }}
<script>{{ .EnhanceScript | unsafe }}</script>
</body>
</html>
