<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-cart-icon="{{ .V.Mode }}" data-component-instance="{{ .NodeID }}">
{{ if .V.Notice }}<p class="sky-cart-icon-notice">{{ .V.Notice }}</p>{{ else }}
{{ if .V.Inline }}<h2 class="sky-cart-inline-title">{{ .V.Label }}</h2>{{ include "site_cart" .V }}
{{ else if .V.UseDetails }}
<details class="sky-cart-icon-details"{{ if .V.ShowCount }} data-cart-icon-count{{ end }} data-cart-icon-panel>
<summary class="sky-cart-icon-trigger" aria-label="{{ .V.Label }}"><span class="sky-cart-icon-glyph" aria-hidden="true">{{ unsafe(.V.IconSVG) }}</span>{{ if .V.ShowLabel }}<span class="sky-cart-icon-label">{{ .V.Label }}</span>{{ end }}{{ if .V.ShowCount }}<span class="sky-cart-icon-count" data-site-read="{{ .V.SummaryURL }}" data-site-view="cartCount" data-site-cart aria-live="polite">0</span>{{ end }}</summary>
<div class="sky-cart-icon-panel">{{ include "site_cart" .V }}</div></details>
{{ else }}
<div class="sky-cart-icon-hoverwrap"><input type="checkbox" class="sky-cart-icon-toggle" id="sky-cart-icon-toggle-{{ .NodeID }}" aria-label="{{ .V.Label }}">
<label class="sky-cart-icon-trigger" for="sky-cart-icon-toggle-{{ .NodeID }}"><span class="sky-cart-icon-glyph" aria-hidden="true">{{ unsafe(.V.IconSVG) }}</span>{{ if .V.ShowLabel }}<span class="sky-cart-icon-label">{{ .V.Label }}</span>{{ end }}{{ if .V.ShowCount }}<span class="sky-cart-icon-count" data-site-read="{{ .V.SummaryURL }}" data-site-view="cartCount" data-site-cart aria-live="polite">0</span>{{ end }}</label>
<label class="sky-cart-icon-cover" for="sky-cart-icon-toggle-{{ .NodeID }}" aria-hidden="true"></label><div class="sky-cart-icon-panel">{{ include "site_cart" .V }}</div></div>
{{ end }}{{ end }}</div>
