<ul class="{{ .Classes }} sky-list sky-list-{{ .V.Style }}">{{ range _, item := .V.Items }}<li class="sky-list-item"><span class="sky-list-marker" aria-hidden="true">{{ unsafe(item.MarkerHTML) }}</span>{{ if item.IsLink }}<a class="sky-list-text" href="{{ item.LinkHref }}">{{ item.Text }}</a>{{ else }}<span class="sky-list-text">{{ item.Text }}</span>{{ end }}</li>{{ end }}</ul>