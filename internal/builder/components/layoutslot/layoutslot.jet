{{ if .V.IsPlaceholder }}<div class="sky-layoutslot {{ .Classes }}" data-sky-id="{{ .V.NodeID }}"{{ if .V.Slot }} data-sky-slot="{{ .V.Slot }}"{{ end }}{{ if .V.RefID }} data-sky-ref="{{ .V.RefID }}"{{ end }}{{ if .V.Reason }} data-sky-degrade="{{ .V.Reason }}"{{ end }}><!-- 结构槽位 --></div>{{ else }}{{ range _, child := .Children }}{{ include child.Template child }}{{ end }}{{ end }}