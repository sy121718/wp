{{ if .V.IsPlaceholder }}<div class="sky-layoutslot {{ .Classes }}" data-sky-id="{{ .V.NodeID }}"{{ if .V.Slot }} data-sky-slot="{{ .V.Slot }}"{{ end }}{{ if .V.RefID }} data-sky-ref="{{ .V.RefID }}"{{ end }}{{ if .V.Reason }} data-sky-degrade="{{ .V.Reason }}"{{ end }}><!-- 结构槽位 --></div>{{ else }}{{ if .SlotFrame }}<div class="sky-slot-frame" data-sky-slot="{{ .SlotFrame.Slot }}" data-sky-slot-ref="{{ .SlotFrame.Ref }}" data-sky-slot-ref-kind="{{ .SlotFrame.RefKind }}" data-sky-id="{{ .SlotFrame.NodeID }}">{{ range _, child := .Children }}{{ include child.Template child }}{{ end }}</div>{{ else }}{{ range _, child := .Children }}{{ include child.Template child }}{{ end }}{{ end }}{{ end }}
