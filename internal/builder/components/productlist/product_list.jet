<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-sky-product-list data-site-catalog data-site-read="{{ .V.DataURL }}" data-site-view="catalog" data-catalog-category-single="{{ .V.CategorySingle }}" data-catalog-default-query="{{ .V.PushQuery }}" data-catalog-currency="{{ .V.Currency }}" data-catalog-empty="{{ .V.EmptyText }}" data-catalog-prev="{{ .V.Labels.Prev }}" data-catalog-next="{{ .V.Labels.Next }}">
<template data-catalog-card><li class="sky-product-list-item">
{{ if .V.ImageField }}<a class="sky-product-list-media" data-catalog-link tabindex="-1" aria-hidden="true"><img data-catalog-image="{{ .V.ImageField }}" data-catalog-alt="{{ .V.ImageAltField }}" loading="lazy" decoding="async"></a>{{ end }}
<div class="sky-product-list-body">{{ if .V.TitleField }}<{{ .V.TitleTag }} class="sky-product-list-title"><a data-catalog-link data-catalog-value="{{ .V.TitleField }}"></a></{{ .V.TitleTag }}>{{ end }}
<div class="sky-product-list-price-row">{{ if .V.PriceField }}<span class="sky-product-list-price" data-catalog-price="{{ .V.PriceField }}"></span>{{ end }}{{ if .V.ComparePriceField }}<span class="sky-product-list-compare" data-catalog-price="{{ .V.ComparePriceField }}"></span>{{ end }}</div>
{{ if .V.TagsField }}<ul class="sky-product-list-tags" data-catalog-tags="{{ .V.TagsField }}"></ul>{{ end }}</div>
</li></template>
<p data-site-status role="status" aria-live="polite"></p>
<div class="sky-product-list-layout">
{{ if len(.V.FilterSections) > 0 }}<aside class="sky-product-list-filters" aria-label="{{ .V.Labels.Filters }}">{{ range _, section := .V.FilterSections }}<div class="sky-product-list-filter sky-product-list-filter-{{ section.Kind }}"{{ if section.CaretIcon }} data-caret="{{ section.CaretIcon }}"{{ end }}{{ if not section.Multi }} data-multi="off"{{ end }}>
<h3 class="sky-product-list-filter-title">{{ section.Title }}</h3>
{{ if section.Render == "tree" }}<ul class="sky-product-list-tree">{{ range _, item := section.Tree }}{{ item.OpenTags | raw }}<a class="sky-product-list-node-label{{ if item.State == "all" }} is-active{{ else if item.State == "partial" }} is-partial{{ end }}" href="{{ item.Option.Href }}" data-catalog-query="{{ item.Option.ActionQuery }}"{{ if item.State == "all" }} aria-current="true"{{ end }} aria-checked="{{ item.State }}" role="menuitemcheckbox">{{ if section.Multi }}<input type="checkbox" class="sky-product-list-node-box" aria-hidden="true" tabindex="-1"{{ if item.State == "all" }} checked{{ end }}>{{ end }}{{ item.Option.Label }}</a>{{ item.MidTags | raw }}{{ item.CloseTags | raw }}{{ end }}</ul>{{ else }}<ul class="sky-product-list-filter-options">{{ range _, opt := section.Options }}<li>{{ if opt.Disabled }}<span class="sky-product-list-filter-option is-disabled" title="{{ opt.DisabledHint }}">{{ opt.Label }}</span>{{ else }}<a class="sky-product-list-filter-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" data-catalog-query="{{ opt.ActionQuery }}"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a>{{ end }}</li>{{ end }}</ul>{{ end }}
</div>{{ end }}{{ if .V.HasRatingSection }}<div class="sky-product-list-filter sky-product-list-filter-rating">
<h3 class="sky-product-list-filter-title">{{ .V.Labels.Rating }}</h3>
<ul class="sky-product-list-filter-options">{{ range _, opt := .V.RatingOptions }}<li><a class="sky-product-list-filter-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" data-catalog-query="{{ opt.ActionQuery }}"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul>
</div>{{ end }}{{ if .V.HasPriceSection }}<div class="sky-product-list-filter sky-product-list-filter-price">
<h3 class="sky-product-list-filter-title">{{ .V.Labels.Price }}</h3>
{{ if len(.V.PriceOptions) > 0 }}<ul class="sky-product-list-filter-options">{{ range _, opt := .V.PriceOptions }}<li><a class="sky-product-list-filter-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" data-catalog-query="{{ opt.ActionQuery }}"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul>{{ end }}
{* 价格查询由前端读取并更新公开JSON，静态表单与输入保持原位。 *}
{{ if .V.ShowPriceSlider }}<form class="sky-product-list-price-slider" action="{{ .V.PriceFormAction }}" method="get" data-catalog-price-form>
<label class="sky-product-list-price-field"><span class="sky-product-list-price-label">{{ .V.Labels.PriceMin }}</span><input class="sky-product-list-price-range" type="range" name="minPrice" min="{{ .V.PriceBoundMin }}" max="{{ .V.PriceBoundMax }}" step="1" value="{{ .V.PriceFromValue }}" aria-label="{{ .V.Labels.PriceMinAria }}"><output class="sky-product-list-price-value">{{ .V.PriceFromValue }}</output></label>
<label class="sky-product-list-price-field"><span class="sky-product-list-price-label">{{ .V.Labels.PriceMax }}</span><input class="sky-product-list-price-range" type="range" name="maxPrice" min="{{ .V.PriceBoundMin }}" max="{{ .V.PriceBoundMax }}" step="1" value="{{ .V.PriceToValue }}" aria-label="{{ .V.Labels.PriceMaxAria }}"><output class="sky-product-list-price-value">{{ .V.PriceToValue }}</output></label>
<button class="sky-product-list-price-apply" type="submit">{{ .V.Labels.PriceApply }}</button>
</form>{{ end }}
</div>{{ end }}</aside>{{ end }}
<div class="sky-product-list-main">
{{ if len(.V.SortOptions) > 0 }}<div class="sky-product-list-toolbar"><div class="sky-product-list-tool"><span class="sky-product-list-tool-label">{{ .V.Labels.Sort }}</span><ul class="sky-product-list-tool-options">{{ range _, opt := .V.SortOptions }}<li>{{ if opt.Disabled }}<span class="sky-product-list-tool-option is-disabled" title="{{ opt.DisabledHint }}">{{ opt.Label }}</span>{{ else }}<a class="sky-product-list-tool-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" data-catalog-query="{{ opt.ActionQuery }}"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a>{{ end }}</li>{{ end }}</ul></div></div>{{ end }}
{{ if len(.V.PageSizeOptions) > 0 }}<div class="sky-product-list-toolbar"><div class="sky-product-list-tool"><span class="sky-product-list-tool-label">{{ .V.Labels.PageSize }}</span><ul class="sky-product-list-tool-options">{{ range _, opt := .V.PageSizeOptions }}<li><a class="sky-product-list-tool-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" data-catalog-query="{{ opt.ActionQuery }}"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul></div></div>{{ end }}
{{ if len(.V.ColumnOptions) > 0 }}<div class="sky-product-list-toolbar"><div class="sky-product-list-tool"><span class="sky-product-list-tool-label">{{ .V.Labels.View }}</span><ul class="sky-product-list-tool-options">{{ range _, opt := .V.ColumnOptions }}<li><a class="sky-product-list-tool-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" data-catalog-query="{{ opt.ActionQuery }}"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul></div></div>{{ end }}
{{ if len(.V.OnSaleOptions) > 0 }}<div class="sky-product-list-toolbar"><div class="sky-product-list-tool"><span class="sky-product-list-tool-label">{{ .V.Labels.OnSale }}</span><ul class="sky-product-list-tool-options">{{ range _, opt := .V.OnSaleOptions }}<li><a class="sky-product-list-tool-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" data-catalog-query="{{ opt.ActionQuery }}"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul></div></div>{{ end }}
<div data-catalog-results>{{ if .V.Empty }}<p class="sky-product-list-empty">{{ .V.EmptyText }}</p>{{ else }}
<ul class="sky-product-list-items">
{{ range _, card := .V.Cards }}<li class="sky-product-list-item">
{{ if card.HasImage }}<a class="sky-product-list-media" href="{{ card.Href }}" tabindex="-1" aria-hidden="true"><img src="{{ card.ImageURL }}" alt="{{ card.ImageAlt }}" loading="lazy" decoding="async"></a>{{ end }}
<div class="sky-product-list-body">
{{ if card.HasTitle }}<{{ card.TitleTag }} class="sky-product-list-title">{{ if card.Href }}<a href="{{ card.Href }}">{{ card.Title }}</a>{{ else }}{{ card.Title }}{{ end }}</{{ card.TitleTag }}>{{ end }}
{{ if card.HasPrice }}<div class="sky-product-list-price-row"><span class="sky-product-list-price">{{ card.Price }}</span>{{ if card.HasComparePrice }}<span class="sky-product-list-compare">{{ card.ComparePrice }}</span>{{ end }}</div>{{ end }}
{{ if len(card.Tags) > 0 }}<ul class="sky-product-list-tags">{{ range _, tag := card.Tags }}<li class="sky-product-list-tag">{{ tag }}</li>{{ end }}</ul>{{ end }}
</div>
</li>{{ end }}
</ul>
{{ end }}
</div>
<nav data-catalog-pager hidden aria-label="{{ .V.Labels.Pager }}"></nav>
{{ if .V.HasPager }}<nav data-catalog-initial-pager class="sky-product-list-pager" aria-label="{{ .V.Labels.Pager }}">{{ if .V.HasPrev }}<a class="sky-product-list-page" href="{{ .V.PrevLink.Href }}" data-catalog-query="{{ .V.PrevLink.ActionQuery }}" rel="prev">{{ .V.Labels.Prev }}</a>{{ end }}<span class="sky-product-list-page-current" aria-current="page">{{ .V.PageText }}</span>{{ if .V.HasNext }}<a class="sky-product-list-page" href="{{ .V.NextLink.Href }}" data-catalog-query="{{ .V.NextLink.ActionQuery }}" rel="next">{{ .V.Labels.Next }}</a>{{ end }}</nav>{{ end }}
{{ if .V.HasListPageLink }}<p class="sky-product-list-more"><a class="sky-product-list-more-link" href="{{ .V.ListPageLinkHref }}"{{ if .V.ListPageNewTab }} target="_blank" rel="noopener noreferrer"{{ end }}>{{ .V.ListPageLinkText }}</a></p>{{ end }}
</div>
</div>
</div>
