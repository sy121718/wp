{* product_list.jet — core.productList 商品列表组件（#23 / #27）。 *}
{* 交互契约（无 JS 也能用）：
   · 每个筛选 / 排序 / 翻页控件都是 <a>：没有 HTMX 时就是整页跳转，URL 里的语义参数照旧生效；
   · 有 HTMX 时同一批链接带 hx-get（片段请求，含实例配置）与 hx-push-url（只推语义参数），
     变成局部刷新，地址栏同步、可分享、可刷新、可前进后退；
   · 容器自带 load 补正：带 query 直接打开 / 刷新 / 前进后退时，由片段补一次请求，
     把列表换成筛过的结果（静态产物本身是「默认那一屏」）。 *}
{* 集合项在构建期已解析、排序并分页切片；空集合渲染空态文案，不输出空 <ul>。 *}
<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-sky-product-list hx-get="/_fragments/productList?{{ .V.FragmentQuery }}" hx-vals='js:Object.fromEntries(new URLSearchParams(location.search))' hx-trigger="load[location.search.length > 1]" hx-target="this" hx-swap="outerHTML">
<div class="sky-product-list-layout">
{{ if len(.V.FilterSections) > 0 }}<aside class="sky-product-list-filters" aria-label="{{ .V.Labels.Filters }}">{{ range _, section := .V.FilterSections }}<div class="sky-product-list-filter sky-product-list-filter-{{ section.Kind }}">
<h3 class="sky-product-list-filter-title">{{ section.Title }}</h3>
<ul class="sky-product-list-filter-options">{{ range _, opt := section.Options }}<li>{{ if opt.Disabled }}<span class="sky-product-list-filter-option is-disabled" title="{{ opt.DisabledHint }}">{{ opt.Label }}</span>{{ else }}<a class="sky-product-list-filter-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" hx-get="{{ opt.FragmentGet }}" hx-push-url="{{ opt.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a>{{ end }}</li>{{ end }}</ul>
</div>{{ end }}{{ if .V.HasRatingSection }}<div class="sky-product-list-filter sky-product-list-filter-rating">
<h3 class="sky-product-list-filter-title">{{ .V.Labels.Rating }}</h3>
<ul class="sky-product-list-filter-options">{{ range _, opt := .V.RatingOptions }}<li><a class="sky-product-list-filter-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" hx-get="{{ opt.FragmentGet }}" hx-push-url="{{ opt.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul>
</div>{{ end }}{{ if .V.HasPriceSection }}<div class="sky-product-list-filter sky-product-list-filter-price">
<h3 class="sky-product-list-filter-title">{{ .V.Labels.Price }}</h3>
{{ if len(.V.PriceOptions) > 0 }}<ul class="sky-product-list-filter-options">{{ range _, opt := .V.PriceOptions }}<li><a class="sky-product-list-filter-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" hx-get="{{ opt.FragmentGet }}" hx-push-url="{{ opt.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul>{{ end }}
{* 滑块：有 JS 时 hx-get 走片段局部刷新；没 JS 时 action 是只带语义参数的干净 URL，原生 GET 提交后由容器 load 补正。 *}
{{ if .V.ShowPriceSlider }}<form class="sky-product-list-price-slider" action="{{ .V.PriceFormAction }}" method="get" hx-get="{{ .V.PriceFragmentGet }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML" hx-push-url="true" hx-trigger="change">
<label class="sky-product-list-price-field"><span class="sky-product-list-price-label">{{ .V.Labels.PriceMin }}</span><input class="sky-product-list-price-range" type="range" name="minPrice" min="{{ .V.PriceBoundMin }}" max="{{ .V.PriceBoundMax }}" step="1" value="{{ .V.PriceFromValue }}" aria-label="{{ .V.Labels.PriceMinAria }}"><output class="sky-product-list-price-value">{{ .V.PriceFromValue }}</output></label>
<label class="sky-product-list-price-field"><span class="sky-product-list-price-label">{{ .V.Labels.PriceMax }}</span><input class="sky-product-list-price-range" type="range" name="maxPrice" min="{{ .V.PriceBoundMin }}" max="{{ .V.PriceBoundMax }}" step="1" value="{{ .V.PriceToValue }}" aria-label="{{ .V.Labels.PriceMaxAria }}"><output class="sky-product-list-price-value">{{ .V.PriceToValue }}</output></label>
<button class="sky-product-list-price-apply" type="submit">{{ .V.Labels.PriceApply }}</button>
</form>{{ end }}
</div>{{ end }}</aside>{{ end }}
<div class="sky-product-list-main">
{{ if len(.V.SortOptions) > 0 }}<div class="sky-product-list-toolbar"><div class="sky-product-list-tool"><span class="sky-product-list-tool-label">{{ .V.Labels.Sort }}</span><ul class="sky-product-list-tool-options">{{ range _, opt := .V.SortOptions }}<li>{{ if opt.Disabled }}<span class="sky-product-list-tool-option is-disabled" title="{{ opt.DisabledHint }}">{{ opt.Label }}</span>{{ else }}<a class="sky-product-list-tool-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" hx-get="{{ opt.FragmentGet }}" hx-push-url="{{ opt.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a>{{ end }}</li>{{ end }}</ul></div></div>{{ end }}
{{ if len(.V.PageSizeOptions) > 0 }}<div class="sky-product-list-toolbar"><div class="sky-product-list-tool"><span class="sky-product-list-tool-label">{{ .V.Labels.PageSize }}</span><ul class="sky-product-list-tool-options">{{ range _, opt := .V.PageSizeOptions }}<li><a class="sky-product-list-tool-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" hx-get="{{ opt.FragmentGet }}" hx-push-url="{{ opt.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul></div></div>{{ end }}
{{ if len(.V.ColumnOptions) > 0 }}<div class="sky-product-list-toolbar"><div class="sky-product-list-tool"><span class="sky-product-list-tool-label">{{ .V.Labels.View }}</span><ul class="sky-product-list-tool-options">{{ range _, opt := .V.ColumnOptions }}<li><a class="sky-product-list-tool-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" hx-get="{{ opt.FragmentGet }}" hx-push-url="{{ opt.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul></div></div>{{ end }}
{{ if len(.V.OnSaleOptions) > 0 }}<div class="sky-product-list-toolbar"><div class="sky-product-list-tool"><span class="sky-product-list-tool-label">{{ .V.Labels.OnSale }}</span><ul class="sky-product-list-tool-options">{{ range _, opt := .V.OnSaleOptions }}<li><a class="sky-product-list-tool-option{{ if opt.Active }} is-active{{ end }}" href="{{ opt.Href }}" hx-get="{{ opt.FragmentGet }}" hx-push-url="{{ opt.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML"{{ if opt.Active }} aria-current="true"{{ end }}>{{ opt.Label }}</a></li>{{ end }}</ul></div></div>{{ end }}
{{ if .V.Empty }}<p class="sky-product-list-empty">{{ .V.EmptyText }}</p>{{ else }}
<ul class="sky-product-list-items">
{{ range _, card := .V.Cards }}<li class="sky-product-list-item">
{{ if card.HasImage }}<a class="sky-product-list-media" href="{{ card.Href }}" tabindex="-1" aria-hidden="true"><img src="{{ card.ImageURL }}" alt="{{ card.ImageAlt }}" loading="lazy" decoding="async"></a>{{ end }}
<div class="sky-product-list-body">
{{ if card.HasTitle }}<{{ card.TitleTag }} class="sky-product-list-title">{{ if card.Href }}<a href="{{ card.Href }}">{{ card.Title }}</a>{{ else }}{{ card.Title }}{{ end }}</{{ card.TitleTag }}>{{ end }}
{{ if card.HasPrice }}<div class="sky-product-list-price-row"><span class="sky-product-list-price">{{ card.Price }}</span>{{ if card.HasComparePrice }}<span class="sky-product-list-compare">{{ card.ComparePrice }}</span>{{ end }}</div>{{ end }}
{{ if len(card.Tags) > 0 }}<ul class="sky-product-list-tags">{{ range _, tag := card.Tags }}<li class="sky-product-list-tag">{{ tag }}</li>{{ end }}</ul>{{ end }}
</div>
</li>{{ end }}
</ul>
{{ end }}
{{ if .V.HasPager }}<nav class="sky-product-list-pager" aria-label="{{ .V.Labels.Pager }}">{{ if .V.HasPrev }}<a class="sky-product-list-page" href="{{ .V.PrevLink.Href }}" hx-get="{{ .V.PrevLink.FragmentGet }}" hx-push-url="{{ .V.PrevLink.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML" rel="prev">{{ .V.Labels.Prev }}</a>{{ end }}<span class="sky-product-list-page-current" aria-current="page">{{ .V.PageText }}</span>{{ if .V.HasNext }}<a class="sky-product-list-page" href="{{ .V.NextLink.Href }}" hx-get="{{ .V.NextLink.FragmentGet }}" hx-push-url="{{ .V.NextLink.PushURL }}" hx-target="closest [data-sky-product-list]" hx-swap="outerHTML" rel="next">{{ .V.Labels.Next }}</a>{{ end }}</nav>{{ end }}
{{ if .V.HasListPageLink }}<p class="sky-product-list-more"><a class="sky-product-list-more-link" href="{{ .V.ListPageLinkHref }}">{{ .V.ListPageLinkText }}</a></p>{{ end }}
</div>
</div>
</div>
