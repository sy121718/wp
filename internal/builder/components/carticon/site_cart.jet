<div class="sky-cart" data-site-cart data-site-read="{{ .CartViewURL }}" data-site-view="cart" data-project-id="{{ .ProjectID }}" data-label-off-shelf="{{ .CartLabels.OffShelf }}" data-label-out="{{ .CartLabels.Out }}" data-label-low="{{ .CartLabels.Low }}" data-label-in="{{ .CartLabels.In }}" data-label-unknown="{{ .CartLabels.Unknown }}" data-write-host>
<p data-site-status role="status">{{ .LoadingText }}</p><p data-cart-empty hidden>{{ .CartLabels.Empty }}</p>
<ul class="sky-cart-items" data-cart-items></ul>
<template data-cart-row><li class="sky-cart-item"><span class="sky-cart-name"><span data-cart-name></span><span class="sky-cart-variant" data-cart-variant></span></span><span class="sky-cart-unit" data-cart-unit></span><form class="sky-cart-qty" method="post" data-write="custom" data-write-url="/api/site/cart/quantity" data-msg-failed="更新失败，请重试"><input type="hidden" name="projectId" value="{{ .ProjectID }}"><input type="hidden" name="variantId"><input class="sky-cart-qty-input" type="number" name="quantity" min="0" inputmode="numeric" aria-label="{{ .CartLabels.Qty }}"><button class="sky-cart-qty-submit" type="submit">{{ .CartLabels.Update }}</button><button class="sky-cart-qty-submit" type="submit" name="quantity" value="0" formnovalidate data-write-extra="quantity" data-cart-remove>{{ .CartLabels.Remove }}</button></form><span class="sky-cart-line" data-cart-line></span><span class="sky-cart-note" data-cart-stock></span></li></template>
<p class="sky-cart-total" data-cart-total-wrap hidden><span>{{ .CartLabels.Total }}</span><strong data-cart-total></strong></p>
{{ if .CheckoutHref }}<a class="sky-cart-checkout" href="{{ .CheckoutHref }}" data-cart-checkout hidden>{{ .CartLabels.Checkout }}</a>{{ end }}
<form class="sky-cart-clear" method="post" data-write="custom" data-write-url="/api/site/cart/clear" data-cart-clear hidden data-msg-failed="清空失败，请重试"><input type="hidden" name="projectId" value="{{ .ProjectID }}"><button type="submit" data-requires-js hidden disabled>{{ .CartLabels.Clear }}</button></form><p data-write-status role="status" hidden></p>
<noscript>请启用 JavaScript 后操作购物车。</noscript></div>
