{* cart_icon.jet — 购物车图标（core.cartIcon）。

   产物里只有图标与外壳，车里的东西由片段 /_fragments/cartView 现拉：
   购物车是每个访客各不相同的动态状态，烘进静态产物等于把某一个人的车发布给所有人。

   三种浮层形态（dropdown / drawer / modal）共用 <details> —— 原生可展开元素，
   无 JS 也能开合、键盘可达、触屏可用；只有「点外部关闭」由 enhance.js 补上。
   hover 形态不用 details：桌面用 CSS 悬停预览；触屏没有悬停，改由 sr-only checkbox +
   覆盖层 label 的「点一下展开 / 再点收起」驱动（与导航子菜单同一套手法，零 JS）。 *}
<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-cart-icon="{{ .V.Mode }}">
{{ if .V.Notice }}<p class="sky-cart-icon-notice">{{ .V.Notice }}</p>{{ else }}{{ icon := .V.IconSVG }}{{ label := .V.Label }}{{ showLabel := .V.ShowLabel }}{{ showCount := .V.ShowCount }}{{ summaryURL := .V.SummaryURL }}{{ viewURL := .V.CartViewURL }}{{ cartURL := .V.CartURL }}{{ hasCart := .V.HasCartURL }}{{ if .V.UseDetails }}<details class="sky-cart-icon-details"{{ if .V.ShowCount }} data-cart-icon-count{{ end }} data-cart-icon-panel><summary class="sky-cart-icon-trigger" aria-label="{{ label }}"><span class="sky-cart-icon-glyph" aria-hidden="true">{{ unsafe(icon) }}</span>{{ if showLabel }}<span class="sky-cart-icon-label">{{ label }}</span>{{ end }}{{ if showCount }}<span class="sky-cart-icon-count" hx-get="{{ summaryURL }}" hx-trigger="load" hx-swap="innerHTML" aria-live="polite">0</span>{{ end }}</summary><div class="sky-cart-icon-panel" hx-get="{{ viewURL }}" hx-trigger="load" hx-swap="innerHTML"><p class="sky-cart-icon-placeholder">正在加载购物车…{{ if hasCart }} <a href="{{ cartURL }}">查看购物车</a>{{ end }}</p></div></details>{{ else }}<div class="sky-cart-icon-hoverwrap"><input type="checkbox" class="sky-cart-icon-toggle" id="sky-cart-icon-toggle-{{ .NodeID }}" aria-label="{{ label }}"><a class="sky-cart-icon-trigger" href="{{ if hasCart }}{{ cartURL }}{{ else }}#{{ end }}" aria-label="{{ label }}"><span class="sky-cart-icon-glyph" aria-hidden="true">{{ unsafe(icon) }}</span>{{ if showLabel }}<span class="sky-cart-icon-label">{{ label }}</span>{{ end }}{{ if showCount }}<span class="sky-cart-icon-count" hx-get="{{ summaryURL }}" hx-trigger="load" hx-swap="innerHTML" aria-live="polite">0</span>{{ end }}</a><label class="sky-cart-icon-cover" for="sky-cart-icon-toggle-{{ .NodeID }}" aria-hidden="true"></label><div class="sky-cart-icon-panel" hx-get="{{ viewURL }}" hx-trigger="load" hx-swap="innerHTML"><p class="sky-cart-icon-placeholder">正在加载购物车…{{ if hasCart }} <a href="{{ cartURL }}">查看购物车</a>{{ end }}</p></div></div>{{ end }}{{ end }}</div>
