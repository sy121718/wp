<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-cart-icon="{{ .V.Mode }}">
{{ if .V.Notice }}<p class="sky-cart-icon-notice">{{ .V.Notice }}</p>{{ else }}{{ icon := .V.IconSVG }}{{ label := .V.Label }}{{ showLabel := .V.ShowLabel }}{{ showCount := .V.ShowCount }}{{ summaryURL := .V.SummaryURL }}{{ viewURL := .V.CartViewURL }}{{ cartURL := .V.CartURL }}{{ hasCart := .V.HasCartURL }}{{ loading := .V.LoadingText }}{{ viewCart := .V.ViewCartText }}{{ if .V.UseDetails }}<details class="sky-cart-icon-details"{{ if .V.ShowCount }} data-cart-icon-count{{ end }} data-cart-icon-panel><summary class="sky-cart-icon-trigger" aria-label="{{ label }}"><span class="sky-cart-icon-glyph" aria-hidden="true">{{ unsafe(icon) }}</span>{{ if showLabel }}<span class="sky-cart-icon-label">{{ label }}</span>{{ end }}{{ if showCount }}<span class="sky-cart-icon-count" data-site-read="{{ summaryURL }}" data-site-view="cartCount" data-site-cart aria-live="polite">0</span>{{ end }}</summary><div class="sky-cart-icon-panel">{{ include "site_cart" .V }}</div></details>{{ else }}<div class="sky-cart-icon-hoverwrap"><input type="checkbox" class="sky-cart-icon-toggle" id="sky-cart-icon-toggle-{{ .NodeID }}" aria-label="{{ label }}"><a class="sky-cart-icon-trigger" href="{{ if hasCart }}{{ cartURL }}{{ else }}#{{ end }}" aria-label="{{ label }}"><span class="sky-cart-icon-glyph" aria-hidden="true">{{ unsafe(icon) }}</span>{{ if showLabel }}<span class="sky-cart-icon-label">{{ label }}</span>{{ end }}{{ if showCount }}<span class="sky-cart-icon-count" data-site-read="{{ summaryURL }}" data-site-view="cartCount" data-site-cart aria-live="polite">0</span>{{ end }}</a><label class="sky-cart-icon-cover" for="sky-cart-icon-toggle-{{ .NodeID }}" aria-hidden="true"></label><div class="sky-cart-icon-panel">{{ include "site_cart" .V }}</div></div>{{ end }}{{ end }}</div>
