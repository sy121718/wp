<div class="{{ .Classes }} sky-marquee"{{ if .V.PauseOnHover }} data-pause-on-hover="1"{{ end }}>{{ range _, copyIdx := .V.Copies }}<div class="sky-marquee-track" data-copy="{{ copyIdx }}">{{ range _, child := .Children }}<div class="sky-marquee-item">{{ include child.Template child }}</div>{{ end }}</div>{{ end }}</div>