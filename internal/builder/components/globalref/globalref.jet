{{ if .V.IsPlaceholder }}<div class="sky-globalref {{ .Classes }}" data-sky-id="{{ .V.NodeID }}"{{ if .V.RefID }} data-sky-ref="{{ .V.RefID }}"{{ end }}{{ if .V.Reason }} data-sky-degrade="{{ .V.Reason }}"{{ end }}><!-- 全局块引用 --></div>{{ else }}{{ range _, child := .Children }}{{ include child.Template child }}{{ end }}{{ end }}