<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ range _, item := .V.Items }}<details class="sky-faq-item"{{ if item.Open }} open{{ end }}><summary><span class="sky-faq-question">{{ item.Question }}</span>{{ if .V.ChevronIcon }}{{ .V.ChevronIcon | raw }}{{ end }}</summary><div class="sky-faq-answer">{{ unsafe(item.Answer) }}</div></details>{{ end }}</div>{{ if .V.FAQJSONLD }}{{ unsafe(.V.FAQJSONLD) }}{{ end }}
