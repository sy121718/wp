<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-user-form="{{ .V.Mode }}" data-component-instance="{{ .NodeID }}" data-user-next="{{ .V.Next }}" data-user-auto-title="{{ .V.AutoTitle }}" data-site-read="/api/site/user/session" data-site-view="userSession" data-site-poll="60">
{{ if .V.ShowTitle }}<h2 class="sky-user-title" data-user-title>{{ .V.Title }}</h2>{{ end }}
{{ if .V.Description }}<p class="sky-user-description">{{ .V.Description }}</p>{{ end }}
<div hidden data-user-preview-labels>{{ range _,item := .V.PreviewLabels }}<span data-user-preview-label="{{ item.State }}">{{ item.Text }}</span>{{ end }}</div>
<div hidden data-user-flow-labels><span data-user-flow-label="activation-sent">{{ .V.Labels.Register.VerifyNote }}</span><span data-user-flow-label="activation-mail-failed">{{ .V.Labels.Register.MailFailed }}</span><span data-user-flow-label="activated">{{ .V.Labels.Register.Activated }}</span><span data-user-flow-label="reset-sent">{{ .V.Labels.Forgot.Sent }}</span></div>
<div hidden data-user-titles>{{ range _,item := .V.Titles }}<span data-user-mode-title="{{ item.Mode }}">{{ item.Title }}</span>{{ end }}</div>
<p data-site-status role="status" aria-live="polite"></p><button class="sky-user-link" type="button" data-user-retry hidden>{{ .V.RetryText }}</button>
<div data-user-guest hidden><p>{{ .V.Labels.Account.Guest }}</p><button class="sky-user-link" type="button" data-user-mode="login">{{ .V.Labels.Login.Submit }}</button>
</div>
<div data-user-views>
<section class="sky-user-form" data-user-section="login" data-component-part="login" tabindex="-1"{{ if .V.Mode != "login" }} hidden{{ end }}>
<form class="sky-user-fields" method="post" action="/api/site/user/login" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/login">
<fieldset class="sky-user-fields" data-user-fields disabled>
<label class="sky-user-field">{{ .V.Labels.Login.Identity }}<input class="sky-user-input" type="text" name="account" required autocomplete="username"></label>
<label class="sky-user-field">{{ .V.Labels.Login.Password }}<input class="sky-user-input" type="password" name="password" required autocomplete="current-password"></label>
<label class="sky-user-check"><input type="checkbox" name="remember" value="1">{{ .V.Labels.Login.Remember }}</label><button class="sky-user-submit" type="submit">{{ .V.Labels.Login.Submit }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<nav class="sky-user-secondary"><button class="sky-user-link" type="button" data-user-mode="register">{{ .V.Labels.Login.Register }}</button><button class="sky-user-link" type="button" data-user-mode="forgot">{{ .V.Labels.Login.Forgot }}</button></nav>
</section>
<section class="sky-user-form" data-user-section="register" data-component-part="register" tabindex="-1"{{ if .V.Mode != "register" }} hidden{{ end }}>
<form class="sky-user-fields" data-user-register-entry method="post" action="/api/site/user/register" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/register">
<fieldset class="sky-user-fields" data-user-fields disabled>
<label class="sky-user-field">{{ .V.Labels.Register.Username }}<input class="sky-user-input" type="text" name="username" required minlength="3" maxlength="50" autocomplete="username"></label>
<label class="sky-user-field">{{ .V.Labels.Register.Email }}<input class="sky-user-input" type="email" name="email" required autocomplete="email"></label>
<label class="sky-user-field">{{ .V.Labels.Register.Nickname }}<input class="sky-user-input" type="text" name="nickname" autocomplete="nickname"></label>
<label class="sky-user-field">{{ .V.Labels.Register.Password }}<input class="sky-user-input" type="password" name="password" required minlength="8" autocomplete="new-password"></label>
<button class="sky-user-submit" type="submit">{{ .V.Labels.Register.Submit }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<p class="sky-user-alt">{{ .V.Labels.Register.AfterNote }}</p>
<form class="sky-user-fields" data-user-register-verify hidden method="post" action="/api/site/user/activate" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/activate">
<fieldset class="sky-user-fields" data-user-fields disabled>
<label class="sky-user-field">{{ .V.Labels.Register.VerifyCode }}<input class="sky-user-input" type="text" name="key" required minlength="8" maxlength="8" inputmode="text" autocomplete="one-time-code"></label>
<p class="sky-user-alt">{{ .V.Labels.Register.VerifyNote }}</p><button class="sky-user-submit" type="submit">{{ .V.Labels.Register.VerifySubmit }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<form class="sky-user-fields" data-user-register-resend hidden method="post" action="/api/site/user/resend" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/resend">
<fieldset class="sky-user-fields" data-user-fields disabled><label class="sky-user-field">{{ .V.Labels.Register.Email }}<input class="sky-user-input" type="email" name="email" required autocomplete="email"></label><button class="sky-user-link" type="submit">{{ .V.Labels.Register.Resend }}</button></fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<nav class="sky-user-secondary"><button class="sky-user-link" type="button" data-user-register-step="verify">{{ .V.Labels.Register.HaveCode }}</button><button class="sky-user-link" type="button" data-user-register-step="entry" hidden>{{ .V.Labels.Register.BackRegister }}</button><button class="sky-user-link" type="button" data-user-mode="login">{{ .V.Labels.Register.Login }}</button></nav>
</section>
<section class="sky-user-form" data-user-section="forgot" data-component-part="forgot" tabindex="-1"{{ if .V.Mode != "forgot" }} hidden{{ end }}>
<form class="sky-user-fields" method="post" action="/api/site/user/forgot" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/forgot">
<fieldset class="sky-user-fields" data-user-fields disabled>
<label class="sky-user-field">{{ .V.Labels.Forgot.Email }}<input class="sky-user-input" type="email" name="email" required autocomplete="email"></label>
<button class="sky-user-submit" type="submit">{{ .V.Labels.Forgot.Submit }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<p class="sky-user-alt">{{ .V.Labels.Forgot.Privacy }}</p><button class="sky-user-link" type="button" data-user-mode="login">{{ .V.Labels.Forgot.BackLogin }}</button>
</section>
<section class="sky-user-form" data-user-section="reset" data-component-part="reset" tabindex="-1"{{ if .V.Mode != "reset" }} hidden{{ end }}>
<form class="sky-user-fields" method="post" action="/api/site/user/reset" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/reset">
<fieldset class="sky-user-fields" data-user-fields disabled>
<label class="sky-user-field">{{ .V.Labels.Reset.Email }}<input class="sky-user-input" type="email" name="email" required autocomplete="email"></label>
<label class="sky-user-field">{{ .V.Labels.Reset.Code }}<input class="sky-user-input" type="text" name="key" required minlength="8" maxlength="8" inputmode="text" autocomplete="one-time-code"></label>
<label class="sky-user-field">{{ .V.Labels.Reset.Password }}<input class="sky-user-input" type="password" name="password" required minlength="8" autocomplete="new-password"></label>
<button class="sky-user-submit" type="submit">{{ .V.Labels.Reset.Submit }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<p class="sky-user-alt">{{ .V.Labels.Reset.RevokeNote }}</p><button class="sky-user-link" type="button" data-user-mode="login">{{ .V.Labels.Forgot.BackLogin }}</button>
</section>
<section class="sky-user-form" data-user-section="account" data-component-part="account" tabindex="-1"{{ if .V.Mode != "account" }} hidden{{ end }}>
<p>{{ .V.Labels.Account.LoggedIn }} <strong data-user-value="displayName"></strong></p><nav class="sky-user-nav"><button type="button" class="sky-user-link" data-user-mode="profile">{{ .V.TitleKeys.profile }}</button><button type="button" class="sky-user-link" data-user-mode="preference">{{ .V.TitleKeys.preference }}</button><button type="button" class="sky-user-link" data-user-mode="password">{{ .V.TitleKeys.password }}</button><button type="button" class="sky-user-link" data-user-mode="sessions">{{ .V.TitleKeys.sessions }}</button></nav><form class="sky-user-fields" method="post" action="/api/site/user/logout" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/logout">
<fieldset class="sky-user-fields" data-user-fields disabled>
<button class="sky-user-submit" type="submit">{{ .V.Labels.Account.Logout }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
</section>
<section class="sky-user-form" data-user-section="profile" data-component-part="profile" tabindex="-1"{{ if .V.Mode != "profile" }} hidden{{ end }}>
<dl class="sky-user-meta"><dt>{{ .V.Labels.Profile.Username }}</dt><dd data-user-value="username"></dd><dt>{{ .V.Labels.Profile.Email }}</dt><dd data-user-value="email"></dd><dt>{{ .V.Labels.Profile.RegisteredAt }}</dt><dd data-user-value="registeredAt"></dd><dt>{{ .V.Labels.Profile.LastLogin }}</dt><dd data-user-value="lastLoginTime"></dd></dl><form class="sky-user-fields" method="post" action="/api/site/user/account/profile" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/account/profile">
<fieldset class="sky-user-fields" data-user-fields disabled>
<div class="sky-user-grid"><label class="sky-user-field">{{ .V.Labels.Profile.Nickname }}<input class="sky-user-input" type="text" name="nickname" autocomplete="nickname"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.FirstName }}<input class="sky-user-input" type="text" name="firstName" autocomplete="given-name"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.LastName }}<input class="sky-user-input" type="text" name="lastName" autocomplete="family-name"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Birthday }}<input class="sky-user-input" type="date" name="birthday" autocomplete="bday"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Phone }}<input class="sky-user-input" type="tel" name="phone" autocomplete="tel"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Website }}<input class="sky-user-input" type="url" name="website" placeholder="https://"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Company }}<input class="sky-user-input" type="text" name="company" autocomplete="organization"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Country }}<input class="sky-user-input" type="text" name="country" autocomplete="country-name"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Province }}<input class="sky-user-input" type="text" name="province" autocomplete="address-level1"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.City }}<input class="sky-user-input" type="text" name="city" autocomplete="address-level2"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Zip }}<input class="sky-user-input" type="text" name="postcode" autocomplete="postal-code"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Gender }}<select class="sky-user-input" name="gender"><option value="0">{{ .V.Labels.Profile.GenderUnset }}</option><option value="1">{{ .V.Labels.Profile.GenderMale }}</option><option value="2">{{ .V.Labels.Profile.GenderFemale }}</option></select></label></div><label class="sky-user-field">{{ .V.Labels.Profile.Address }}<input class="sky-user-input" type="text" name="address" autocomplete="street-address"></label>
<label class="sky-user-field">{{ .V.Labels.Profile.Bio }}<textarea class="sky-user-input sky-user-textarea" name="bio"></textarea></label><input type="hidden" name="locale" data-user-field="profileLocale"><input type="hidden" name="timezone" data-user-field="profileTimezone"><button class="sky-user-submit" type="submit">{{ .V.Labels.Profile.Save }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<button class="sky-user-link" type="button" data-user-mode="account">{{ .V.Labels.Account.AccountCenter }}</button>
</section>
<section class="sky-user-form" data-user-section="preference" data-component-part="preference" tabindex="-1"{{ if .V.Mode != "preference" }} hidden{{ end }}>
<form class="sky-user-fields" method="post" action="/api/site/user/account/preference" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/account/preference">
<fieldset class="sky-user-fields" data-user-fields disabled>
<input type="hidden" name="theme"><input type="hidden" name="locale"><label class="sky-user-field">{{ .V.Labels.Preference.PageSize }}<input class="sky-user-input" type="number" name="pageSize" required min="1" max="200"></label>
<label class="sky-user-field">{{ .V.Labels.Preference.Timezone }}<input class="sky-user-input" type="text" name="timezone" placeholder="Asia/Shanghai"></label>
<label class="sky-user-field">{{ .V.Labels.Preference.Visibility }}<select class="sky-user-input" name="profileVisibility"><option value="public">{{ .V.Labels.Preference.VisibilityPublic }}</option><option value="members">{{ .V.Labels.Preference.VisibilityMembers }}</option><option value="private">{{ .V.Labels.Preference.VisibilityPrivate }}</option></select></label><label class="sky-user-check"><input type="checkbox" name="emailNotify" value="1">{{ .V.Labels.Preference.EmailNotify }}</label><label class="sky-user-check"><input type="checkbox" name="smsNotify" value="1">{{ .V.Labels.Preference.SmsNotify }}</label><label class="sky-user-check"><input type="checkbox" name="showOnline" value="1">{{ .V.Labels.Preference.ShowOnline }}</label><button class="sky-user-submit" type="submit">{{ .V.Labels.Preference.Save }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<button class="sky-user-link" type="button" data-user-mode="account">{{ .V.Labels.Account.AccountCenter }}</button>
</section>
<section class="sky-user-form" data-user-section="password" data-component-part="password" tabindex="-1"{{ if .V.Mode != "password" }} hidden{{ end }}>
<form class="sky-user-fields" method="post" action="/api/site/user/account/password" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/account/password">
<fieldset class="sky-user-fields" data-user-fields disabled>
<label class="sky-user-field">{{ .V.Labels.Password.Current }}<input class="sky-user-input" type="password" name="oldPassword" required autocomplete="current-password"></label>
<label class="sky-user-field">{{ .V.Labels.Password.NewPassword }}<input class="sky-user-input" type="password" name="newPassword" required minlength="8" autocomplete="new-password"></label>
<p class="sky-user-alt">{{ .V.Labels.Password.Hint }}</p><button class="sky-user-submit" type="submit">{{ .V.Labels.Password.Submit }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
<button class="sky-user-link" type="button" data-user-mode="account">{{ .V.Labels.Account.AccountCenter }}</button>
</section>
<section class="sky-user-form" data-user-section="sessions" data-component-part="sessions" tabindex="-1"{{ if .V.Mode != "sessions" }} hidden{{ end }}>
<div data-user-devices data-label-current="{{ .V.Labels.Sessions.CurrentDevice }}" data-label-unknown="{{ .V.Labels.Sessions.UnknownBrowser }}" data-label-active="{{ .V.Labels.Sessions.LastActive }}" data-label-created="{{ .V.Labels.Sessions.LoggedInAt }}"><p data-user-empty hidden>{{ .V.Labels.Sessions.Empty }}</p><ul class="sky-user-devices" data-user-device-list></ul><template data-user-device><li class="sky-user-device"><strong data-device-agent></strong><span class="sky-user-tag" data-device-current hidden>{{ .V.Labels.Sessions.CurrentDevice }}</span><p class="sky-user-device-meta" data-device-meta></p><form class="sky-user-fields" method="post" action="/api/site/user/sessions/revoke" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/sessions/revoke">
<fieldset class="sky-user-fields" data-user-fields disabled>
<input type="hidden" name="id"><button class="sky-user-submit" type="submit">{{ .V.Labels.Sessions.Revoke }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
</li></template><form class="sky-user-fields" method="post" action="/api/site/user/sessions/revoke-others" data-write="custom" data-write-handler="user.forms" data-write-url="/api/site/user/sessions/revoke-others">
<fieldset class="sky-user-fields" data-user-fields disabled>
<button class="sky-user-submit" type="submit">{{ .V.Labels.Sessions.RevokeOthers }}</button>
</fieldset><p data-write-status role="status" aria-live="polite"></p></form>
</div><button class="sky-user-link" type="button" data-user-mode="account">{{ .V.Labels.Account.AccountCenter }}</button>
</section>
</div>{{ if .V.HasAuthenticatedAction }}<template data-component-action="authenticated" data-action-kind="{{ .V.AuthenticatedAction.Kind }}" data-action-instance="{{ .V.AuthenticatedAction.InstanceID }}" data-action-part="{{ .V.AuthenticatedAction.PartKey }}" data-action-url="{{ .V.AuthenticatedAction.URL }}"></template>{{ end }}<div data-user-account-read hidden></div><div data-user-devices-read hidden></div><noscript><p class="sky-user-notice">{{ .V.ScriptHint }}</p></noscript>
</div>
