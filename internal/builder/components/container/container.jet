<{{ .Tag }} class="{{ .Classes }}"{{ unsafe(.Attrs) }}>{{ if .BgSlides }}<div class="sky-bg-slides" aria-hidden="true">{{ range _, u := .BgSlides }}<div class="sky-bg-slide" style="background-image:url('{{ u }}')"></div>{{ end }}</div>{{ end }}{{ if .ShapeTop }}<span class="sky-shape sky-shape-top"><svg viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">{{ unsafe(.ShapeTop) }}</svg></span>{{ end }}{{ range _, child := .Children }}{{ include child.Template child }}{{ end }}{{ if .ShapeBottom }}<span class="sky-shape sky-shape-bottom"><svg viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">{{ unsafe(.ShapeBottom) }}</svg></span>{{ end }}</{{ .Tag }}>