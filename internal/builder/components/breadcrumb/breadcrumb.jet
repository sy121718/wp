<nav class="{{ .Classes }} sky-breadcrumb" aria-label="{{ .V.Label }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.Visible }}<ol class="sky-breadcrumb-list">{{ range _, it := .V.Items }}<li class="sky-breadcrumb-item{{ if it.Current }} is-current{{ end }}">{{ if it.URL }}<a class="sky-breadcrumb-link" href="{{ it.URL }}"{{ if it.Current }} aria-current="page"{{ end }}>{{ it.Label }}</a>{{ else }}<span class="sky-breadcrumb-text">{{ it.Label }}</span>{{ end }}</li>{{ if it.Separator }}<li class="sky-breadcrumb-separator" aria-hidden="true">{{ it.Separator }}</li>{{ end }}{{ end }}</ol>{{ end }}</nav>{{ if .V.JSONLD }}{{ unsafe(.V.JSONLD) }}{{ end }}