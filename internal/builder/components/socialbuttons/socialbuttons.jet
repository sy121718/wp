<div class="{{ .Classes }} sky-social sky-social-{{ .V.Color }}">{{ range _, item := .V.Items }}<a class="sky-social-btn" href="{{ item.URL }}" target="_blank" rel="noopener nofollow" aria-label="{{ item.Platform }}">{{ if item.HasIcon }}<svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em">{{ unsafe(item.SVGContent) }}</svg>{{ else }}<span class="sky-social-fallback">{{ item.Initial }}</span>{{ end }}</a>{{ end }}</div>