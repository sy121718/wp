<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-component-instance="{{ .NodeID }}" data-add-to-cart data-site-cart data-site-read="{{ .V.CartReadURL }}" data-site-view="cartState">
<form class="sky-cart-add-row" method="post" action="{{ .V.Action }}" data-write="custom" data-write-handler="commerce.cart" data-write-url="{{ .V.Action }}" data-msg-failed="加购失败，请重试"><input type="hidden" name="projectId" value="{{ .V.ProjectID }}">{{ if .V.Lang }}<input type="hidden" name="lang" value="{{ .V.Lang }}">{{ end }}{{ if .V.ChooseVariant }}<label class="sky-cart-add-choice"><span>{{ .V.VariantAria }}</span><select name="variantId" aria-label="{{ .V.VariantAria }}" required><option value="">{{ .V.VariantAria }}</option>{{ range _, row := .V.Rows }}<option value="{{ row.VariantID }}">{{ row.Label }}</option>{{ end }}</select></label>{{ else }}{{ range _, row := .V.Rows }}<input type="hidden" name="variantId" value="{{ row.VariantID }}">{{ end }}{{ end }}{{ if .V.ShowQuantity }}<input class="sky-cart-add-qty" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ .V.QtyAria }}">{{ else }}<input type="hidden" name="quantity" value="1">{{ end }}<p data-write-status role="status" hidden></p><button class="sky-cart-add-btn" type="submit" data-requires-js hidden disabled>{{ .V.Label }}</button></form><noscript>请启用 JavaScript 后使用购物车。</noscript></div>
