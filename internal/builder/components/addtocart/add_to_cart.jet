<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-add-to-cart{{ if not .V.Notice }} data-site-cart data-site-read="{{ .V.CartReadURL }}" data-site-view="cartState"{{ end }}>
{{ if .V.Notice }}<p class="sky-cart-add-notice">{{ .V.Notice }}</p>{{ else }}{{ action := .V.Action }}{{ projectID := .V.ProjectID }}{{ lang := .V.Lang }}{{ btn := .V.Label }}{{ qtyAria := .V.QtyAria }}{{ showQty := .V.ShowQuantity }}{{ showPrice := .V.ShowRowPrice }}{{ range _, row := .V.Rows }}<form class="sky-cart-add-row" method="post" action="{{ action }}" data-write="custom" data-write-url="{{ action }}" data-msg-failed="加购失败，请重试"><input type="hidden" name="projectId" value="{{ projectID }}">{{ if lang }}<input type="hidden" name="lang" value="{{ lang }}">{{ end }}<input type="hidden" name="variantId" value="{{ row.VariantID }}">{{ if row.Label }}<span class="sky-cart-add-label">{{ row.Label }}</span>{{ end }}{{ if showPrice }}{{ if row.Price }}<span class="sky-cart-add-price">{{ row.Price }}{{ if row.ComparePrice }} <s class="sky-cart-add-compare">{{ row.ComparePrice }}</s>{{ end }}</span>{{ end }}{{ end }}{{ if showQty }}<input class="sky-cart-add-qty" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ qtyAria }}">{{ else }}<input type="hidden" name="quantity" value="1">{{ end }}<p data-write-status role="status" hidden></p><button class="sky-cart-add-btn" type="submit" data-requires-js hidden disabled>{{ btn }}</button></form>
{{ end }}<noscript>请启用 JavaScript 后使用购物车。</noscript>{{ end }}</div>
