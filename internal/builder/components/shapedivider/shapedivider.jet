<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} aria-hidden="true"><svg viewBox="0 0 1440 120" preserveAspectRatio="none" focusable="false" aria-hidden="true">{{ range _, l := .V.Layers }}<path{{ if l.Class }} class="{{ l.Class }}"{{ end }} d="{{ l.D }}" fill="{{ l.Fill }}"{{ if l.FillOpacity }} fill-opacity="{{ l.FillOpacity }}"{{ end }}/>{{ end }}</svg></div>
