{* product_selector.jet — core.productSelector 规格选择器组件（issue #26）：维度值组 + 组合清单 + 实时库存位 *}
{* 构建期只烘变体 id，可用量由访问面片段现取（库存是真源，烘进产物等于发布一份过期库存）。
   无 JS / HTMX 时：radio + label 仍是原生控件（键盘 Tab 进组、方向键切换），全部组合平铺可见，
   库存位显示构建期兜底文案 —— 信息不丢，只是不联动。 *}
<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>
{{ if .V.HasOptions }}{{ nodeID := .NodeID }}{{ showStock := .V.ShowStock }}{{ fallback := .V.StockFallback }}
{{ range _, g := .V.OptionGroups }}<fieldset class="sky-selector-group"><legend class="sky-selector-legend">{{ g.Name }}</legend><div class="sky-selector-values">{{ range _, v := g.Values }}<input type="radio" class="sky-selector-radio" id="sky-sel-{{ nodeID }}-{{ g.Key }}-{{ v.Key }}" name="sky-sel-{{ nodeID }}-{{ g.Key }}" value="{{ v.Key }}"><label class="sky-selector-value" for="sky-sel-{{ nodeID }}-{{ g.Key }}-{{ v.Key }}">{{ v.Label }}</label>{{ end }}</div></fieldset>{{ end }}
<div class="sky-selector-variants">{{ range _, vo := .V.VariantOptions }}<div class="sky-selector-variant"><span class="sky-selector-variant-labels">{{ vo.Labels }}</span><span class="sky-selector-variant-price">{{ vo.Price }}</span>{{ if vo.ComparePrice }}<span class="sky-selector-variant-compare">{{ vo.ComparePrice }}</span>{{ end }}{{ if vo.PriceFactsURL }}<span class="sky-selector-live" data-site-product data-site-view="variantPrice" data-site-read="{{ vo.PriceFactsURL }}" data-variant-id="{{ vo.ID }}" data-price="{{ vo.PriceCents }}" data-currency="{{ .V.Currency }}" data-label-delisted="{{ .V.LiveLabels.Delisted }}" data-label-updated="{{ .V.LiveLabels.Updated }}" aria-live="polite"></span>{{ end }}{{ if showStock }}<span class="sky-selector-stock"{{ if vo.StockFactsURL }} data-site-product data-site-view="variantStock" data-site-read="{{ vo.StockFactsURL }}" data-site-poll="60" data-variant-id="{{ vo.ID }}" data-label-unknown="{{ .V.LiveLabels.Unknown }}" data-label-out="{{ .V.LiveLabels.Out }}" data-label-low="{{ .V.LiveLabels.Low }}" data-label-in="{{ .V.LiveLabels.In }}" aria-live="polite"{{ end }}>{{ fallback }}</span>{{ end }}</div>{{ end }}</div>
{{ else }}{{ if .V.HasEmpty }}<p class="sky-selector-empty">{{ .V.EmptyText }}</p>{{ end }}{{ end }}
</div>
