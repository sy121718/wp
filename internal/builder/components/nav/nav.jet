<nav class="{{ .Classes }} sky-nav" aria-label="{{ .V.Label }}">{{ if .V.MobileCollapse }}<input type="checkbox" class="sky-nav-toggle" id="{{ .V.ToggleID }}" aria-label="{{ .V.ToggleLabel }}"><label class="sky-nav-burger" for="{{ .V.ToggleID }}">{{ if .V.ToggleIcon }}{{ .V.ToggleIcon | raw }}{{ end }}<span class="sky-nav-sr">{{ .V.ToggleLabel }}</span></label>{{ end }}<ul class="sky-nav-list">{{ range idx, it := .V.Items }}<li class="sky-nav-item{{ if it.HasChildren }} has-children{{ end }}{{ if it.HasPanel }} has-panel{{ end }}{{ if it.Current }} is-current{{ end }}"><a href="{{ it.URL }}"{{ if it.Target == "blank" }} target="_blank" rel="noopener"{{ end }}{{ if it.Current }} aria-current="page"{{ end }}>{{ it.Label }}</a>{{ if it.HasChildren }}<input type="checkbox" class="sky-nav-sub-toggle" id="sky-nav-sub-{{ .NodeID }}-{{ idx }}" aria-label="{{ it.Label }} {{ .V.SubmenuToggleLabel }}"><label class="sky-nav-sub-cover" for="sky-nav-sub-{{ .NodeID }}-{{ idx }}" aria-hidden="true"></label><label class="sky-nav-sub-chevron" for="sky-nav-sub-{{ .NodeID }}-{{ idx }}" aria-hidden="true">{{ if .V.ChevronIcon }}{{ .V.ChevronIcon | raw }}{{ end }}</label><ul class="sky-nav-sub">{{ range _, c := it.Children }}<li class="sky-nav-sub-item{{ if c.Current }} is-current{{ end }}"><a href="{{ c.URL }}"{{ if c.Target == "blank" }} target="_blank" rel="noopener"{{ end }}{{ if c.Current }} aria-current="page"{{ end }}>{{ c.Label }}</a></li>{{ end }}</ul>{{ end }}{{ if it.HasPanel }}<input type="checkbox" class="sky-nav-panel-toggle" id="sky-nav-panel-{{ .NodeID }}-{{ idx }}" aria-label="{{ it.Label }} {{ .V.SubmenuToggleLabel }}"><label class="sky-nav-panel-chevron" for="sky-nav-panel-{{ .NodeID }}-{{ idx }}" aria-hidden="true">{{ if .V.ChevronIcon }}{{ .V.ChevronIcon | raw }}{{ end }}</label><div class="sky-nav-panel{{ if it.PanelFull }} sky-nav-panel-full{{ end }}">{{ it.PanelHTML }}</div>{{ end }}</li>{{ end }}</ul></nav>