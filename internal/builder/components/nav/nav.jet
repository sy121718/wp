<nav class="{{ .Classes }} sky-nav" aria-label="{{ .V.Label }}">{{ if .V.MobileCollapse }}<input type="checkbox" class="sky-nav-toggle" id="{{ .V.ToggleID }}" aria-label="{{ .V.ToggleLabel }}"><label class="sky-nav-burger" for="{{ .V.ToggleID }}">{{ .V.ToggleLabel }}</label>{{ end }}<ul class="sky-nav-list">{{ range idx, it := .V.Items }}<li class="sky-nav-item{{ if it.HasChildren }} has-children{{ end }}{{ if it.Current }} is-current{{ end }}"><a href="{{ it.URL }}"{{ if it.Target == "blank" }} target="_blank" rel="noopener"{{ end }}{{ if it.Current }} aria-current="page"{{ end }}>{{ it.Label }}</a>{{ if it.HasChildren }}<input type="checkbox" class="sky-nav-sub-toggle" id="sky-nav-sub-{{ .NodeID }}-{{ idx }}" aria-label="{{ it.Label }} {{ .V.SubmenuToggleLabel }}"><label class="sky-nav-sub-cover" for="sky-nav-sub-{{ .NodeID }}-{{ idx }}" aria-hidden="true"></label><label class="sky-nav-sub-chevron" for="sky-nav-sub-{{ .NodeID }}-{{ idx }}" aria-hidden="true">▾</label><ul class="sky-nav-sub">{{ range _, c := it.Children }}<li class="sky-nav-sub-item{{ if c.Current }} is-current{{ end }}"><a href="{{ c.URL }}"{{ if c.Target == "blank" }} target="_blank" rel="noopener"{{ end }}{{ if c.Current }} aria-current="page"{{ end }}>{{ c.Label }}</a></li>{{ end }}</ul>{{ end }}</li>{{ end }}</ul></nav>