{* product.jet — core.product 商品详情组件（issue #6 / #8）：媒体区 + 信息区 + 规格选择器 *}
{* 构建期字段已静态填入；规格选择器只在「有规格维度且组合 ≥2」时输出（单变体不输出）。
   选择器是原生 radio + label：鼠标点选 / 触屏点按 / 键盘（Tab 进组、方向键切换）都可用，
   不依赖任何 JS（访客请求期零查库零脚本，不变量 1）。 *}
<div class="{{ .Classes }} sky-product-root{{ if .V.HasMedia }}{{ if not .V.HasInfo }} sky-product-root--media-only{{ end }}{{ else }}{{ if not .V.HasGallery }} sky-product-root--info-only{{ end }}{{ end }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.HasMedia || .V.HasGallery }}<div class="sky-product-media">{{ if .V.HasMedia }}<figure class="sky-product-frame"><img src="{{ .V.MediaURL }}" alt="{{ .V.MediaAlt }}" loading="{{ if .V.HasGallery }}lazy{{ else }}eager{{ end }}" decoding="async">{{ if .V.HasDiscount }}<span class="sky-product-discount">{{ .V.DiscountPercent }}</span>{{ end }}</figure>{{ end }}{{ if .V.HasGallery }}<div class="sky-product-gallery">{{ range _, img := .V.Gallery }}<img src="{{ img.URL }}" alt="{{ img.Alt }}" loading="{{ if img.Eager }}eager{{ else }}lazy{{ end }}" decoding="async">{{ end }}</div>{{ end }}</div>{{ end }}<div class="sky-product-info">{{ if .V.HasCategories }}<nav class="sky-product-categories" aria-label="{{ .V.Labels.Categories }}">{{ range idx, c := .V.Categories }}{{ if idx }}<span class="sky-product-categories-sep" aria-hidden="true">,</span> {{ end }}{{ if c.Href }}<a class="sky-product-category" href="{{ c.Href }}">{{ c.Name }}</a>{{ else }}<span class="sky-product-category">{{ c.Name }}</span>{{ end }}{{ end }}</nav>{{ end }}{{ if .V.HasTitle }}<{{ .V.TitleTag }} class="sky-product-title">{{ .V.Title }}</{{ .V.TitleTag }}>{{ end }}{{ if .V.HasRatingLine }}<div class="sky-product-rating">{{ if .V.RatingValue }}<span class="sky-product-rating-value">{{ .V.RatingValue }}</span>{{ end }}<span class="sky-product-rating-count">{{ .V.RatingCount }} {{ .V.Labels.Reviews }}</span></div>{{ end }}{{ if .V.HasSubtitle }}<p class="sky-product-subtitle">{{ .V.Subtitle }}</p>{{ end }}{{ if .V.HasPrice }}<div class="sky-product-price-row"><span class="sky-product-price">{{ .V.Price }}</span>{{ if .V.HasComparePrice }}<span class="sky-product-compare">{{ .V.ComparePrice }}</span>{{ end }}</div>{{ end }}{{ if .V.HasOptions }}{{ nodeID := .NodeID }}<div class="sky-product-options">{{ range _, g := .V.OptionGroups }}<fieldset class="sky-product-option"><legend>{{ g.Name }}</legend>{{ range idx, v := g.Values }}<input type="radio" class="sky-product-option-radio" id="sky-opt-{{ nodeID }}-{{ g.Key }}-{{ v.Key }}" name="sky-opt-{{ nodeID }}-{{ g.Key }}" value="{{ v.Key }}"{{ if idx == 0 }} checked{{ end }}><label class="sky-product-option-value" for="sky-opt-{{ nodeID }}-{{ g.Key }}-{{ v.Key }}">{{ v.Label }}</label>{{ end }}</fieldset>{{ end }}</div><div class="sky-product-variants">{{ range _, vo := .V.VariantOptions }}<div class="sky-product-variant"><span class="sky-product-variant-options">{{ vo.Labels }}</span><span class="sky-product-variant-price">{{ vo.Price }}</span>{{ if vo.ComparePrice }}<span class="sky-product-compare">{{ vo.ComparePrice }}</span>{{ end }}{{ if vo.LivePriceGet }}<span class="sky-product-variant-live" hx-get="{{ vo.LivePriceGet }}" hx-trigger="load" hx-swap="innerHTML" aria-live="polite"></span>{{ end }}<span class="sky-product-variant-stock"{{ if vo.StockAvailabilityGet }} hx-get="{{ vo.StockAvailabilityGet }}" hx-trigger="load, every 60s" hx-swap="innerHTML" aria-live="polite"{{ end }}>{{ .V.StockNote }}</span></div>{{ end }}</div>{{ end }}{{ if .V.HasDescription }}<div class="sky-product-description">{{ unsafe(.V.DescriptionHTML) }}</div>{{ end }}{{ if .V.HasBrand }}<p class="sky-product-brand"><span class="sky-product-brand-label">{{ .V.Labels.Brand }}</span>{{ if .V.Brand.Href }} <a class="sky-product-brand-link" href="{{ .V.Brand.Href }}">{{ .V.Brand.Name }}</a>{{ else }} <span class="sky-product-brand-link">{{ .V.Brand.Name }}</span>{{ end }}</p>{{ end }}</div></div>
