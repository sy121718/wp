<div class="{{ .Classes }}"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-sky-search{{ if !.V.Notice }} data-site-search data-site-read="{{ .V.BaseFragmentURL }}" data-site-view="search" data-search-empty="{{ .V.EmptyQuery }}" data-search-no-results="{{ .V.NoResults }}"{{ end }}>
{{ if .V.Notice }}<p class="sky-search-notice">{{ .V.Notice }}</p>{{ else }}
<form class="sky-search-form" method="get" action="" role="search" data-site-search-form>
<label class="sky-search-label"><span class="sky-search-sr">{{ .V.LabelSR }}</span><input class="sky-search-input" type="search" name="q" placeholder="{{ .V.Placeholder }}" autocomplete="off" enterkeyhint="search" maxlength="64"></label>
<button class="sky-search-submit" type="submit">{{ .V.SubmitText }}</button>
</form>
<p data-site-status role="status" aria-live="polite"></p>
<template data-search-hit><li class="sky-search-item"><a class="sky-search-title"></a><p class="sky-search-excerpt"></p></li></template>
<div class="sky-search-mount" aria-live="polite" data-search-results></div>
{{ end }}
</div>
