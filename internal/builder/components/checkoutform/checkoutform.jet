{{ if .V.Notice }}<div class="{{ .Classes }} sky-checkout sky-checkout-unavailable"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} role="status"><p class="sky-checkout-notice">{{ .V.Notice }}</p></div>{{ else }}<div class="{{ .Classes }} sky-checkout"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }} data-component-instance="{{ .NodeID }}" data-site-checkout-root data-label-paid="{{ .V.ResultLabels.Paid }}" data-label-pending="{{ .V.ResultLabels.Pending }}"><section data-component-part="checkout" tabindex="-1"><form class="sky-checkout-form" method="post" action="{{ .V.Action }}" data-write="custom" data-write-url="{{ .V.Action }}" data-write-handler="commerce.checkout" data-site-cart data-site-checkout data-site-read="{{ .V.CartReadURL }}" data-site-view="cartState" data-msg-failed="提交失败，请重试"><input type="hidden" name="requestId" value="">{{ range _, h := .V.Hidden }}<input type="hidden" name="{{ h.Name }}" value="{{ h.Value }}">{{ end }}{{ range _, g := .V.Groups }}<fieldset class="sky-checkout-group" data-group="{{ g.Key }}"><legend class="sky-checkout-legend">{{ g.Title }}</legend><div class="sky-checkout-grid">{{ range _, f := g.Fields }}<div class="sky-checkout-field{{ if f.Wide }} is-wide{{ end }}"><label for="sky-checkout-{{ .NodeID }}-{{ f.Key }}">{{ f.Label }}</label>{{ if f.Type == "country" }}<select id="sky-checkout-{{ .NodeID }}-{{ f.Key }}" name="{{ f.Key }}"{{ if f.Required }} required{{ end }}>{{ range _, o := f.Options }}<option value="{{ o.Code }}"{{ if o.Selected }} selected{{ end }}>{{ o.Label }}</option>{{ end }}</select>{{ else if f.Type == "textarea" }}<textarea id="sky-checkout-{{ .NodeID }}-{{ f.Key }}" name="{{ f.Key }}"{{ if f.Placeholder }} placeholder="{{ f.Placeholder }}"{{ end }}{{ if f.Required }} required{{ end }}></textarea>{{ else }}<input id="sky-checkout-{{ .NodeID }}-{{ f.Key }}" type="{{ f.Type }}" name="{{ f.Key }}"{{ if f.Placeholder }} placeholder="{{ f.Placeholder }}"{{ end }}{{ if f.Required }} required{{ end }}>{{ end }}</div>{{ end }}</div></fieldset>{{ end }}{{ if .V.Coupon.Label }}<fieldset class="sky-checkout-group sky-checkout-coupon" data-group="coupon"><legend class="sky-checkout-legend">{{ .V.Coupon.Label }}</legend><div class="sky-checkout-grid"><div class="sky-checkout-field is-wide"><label for="sky-checkout-{{ .NodeID }}-couponCode">{{ .V.Coupon.Label }}</label><input id="sky-checkout-{{ .NodeID }}-couponCode" type="text" name="couponCode"{{ if .V.Coupon.Placeholder }} placeholder="{{ .V.Coupon.Placeholder }}"{{ end }}></div></div></fieldset>{{ end }}<p data-write-status role="status" hidden></p><noscript>请启用 JavaScript 后提交订单。</noscript><button type="submit" class="sky-checkout-submit" data-requires-js hidden disabled>{{ .V.SubmitLabel }}</button></form></section><section data-component-part="result" tabindex="-1" data-checkout-result role="status" hidden><h3 data-checkout-title></h3><p><span>{{ .V.ResultLabels.OrderNo }}</span><strong data-checkout-order></strong></p><p data-checkout-total></p><p data-checkout-payment-error hidden>{{ .V.ResultLabels.PaymentFailed }}</p><p data-checkout-account hidden>{{ .V.ResultLabels.AccountMailed }}</p></section>{{ if .V.HasBackAction }}{{ if .V.BackAction.URL }}<a class="sky-checkout-back" href="{{ .V.BackAction.URL }}">{{ .V.BackLabel }}</a>{{ else }}<button class="sky-checkout-back" type="button" data-component-action="back" data-action-kind="{{ .V.BackAction.Kind }}" data-action-instance="{{ .V.BackAction.InstanceID }}" data-action-part="{{ .V.BackAction.PartKey }}">{{ .V.BackLabel }}</button>{{ end }}{{ end }}{{ if .V.HasSuccessAction }}<template data-component-action="success" data-action-kind="{{ .V.SuccessAction.Kind }}" data-action-instance="{{ .V.SuccessAction.InstanceID }}" data-action-part="{{ .V.SuccessAction.PartKey }}"></template>{{ end }}</div>{{ end }}
