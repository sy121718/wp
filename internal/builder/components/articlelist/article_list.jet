<div class="{{ .Classes }} sky-article-list"{{ if .CustomID }} id="{{ .CustomID }}"{{ end }}>{{ if .V.Empty }}<p class="sky-article-list-empty">{{ .V.EmptyText }}</p>{{ else }}<div class="sky-article-list-items" style="--sky-al-cols: {{ .V.GridTemplate }}">{{ range _, c := .V.Cards }}<article class="sky-article-list-card">{{ if c.HasImage }}<a class="sky-article-list-media" href="{{ c.Href }}" tabindex="-1" aria-hidden="true"><img src="{{ c.Image }}" alt="{{ c.Alt }}" loading="lazy" decoding="async"></a>{{ end }}<div class="sky-article-list-body"><{{ .V.TitleTag }} class="sky-article-list-title"><a href="{{ c.Href }}">{{ c.Title }}</a></{{ .V.TitleTag }}>{{ if c.HasExcerpt }}<p class="sky-article-list-excerpt">{{ c.Excerpt }}</p>{{ end }}{{ if c.HasHref }}<a class="sky-article-list-link" href="{{ c.Href }}">{{ .V.LinkText }}</a>{{ end }}</div></article>{{ end }}</div>{{ end }}</div>
