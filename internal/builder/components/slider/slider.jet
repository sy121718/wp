<div class="{{ .Classes }} sky-slider" data-slider="{{ .V.DataSlider }}" tabindex="0"{{ if .V.HasAutoplay }} data-autoplay="{{ .V.Autoplay }}"{{ end }}{{ if .V.Loop }} data-loop="1"{{ end }}><div class="sky-slider-track" data-track="1">{{ range i, child := .Children }}<div class="sky-slide" id="sky-slide-{{ .NodeID }}-{{ i }}">{{ include child.Template child }}</div>{{ end }}</div>{{ if .V.ShowArrows }}<button type="button" class="sky-slider-arrow sky-slider-prev" data-prev="1" aria-label="{{ .V.PrevLabel }}">‹</button><button type="button" class="sky-slider-arrow sky-slider-next" data-next="1" aria-label="{{ .V.NextLabel }}">›</button>{{ end }}{{ if .V.ShowDots }}<div class="sky-slider-dots">{{ range _, d := .V.Dots }}<a class="sky-slider-dot" href="#{{ d.Anchor }}" aria-label="{{ d.Label }}"></a>{{ end }}</div>{{ end }}</div>