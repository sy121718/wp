<div class="{{ .Classes }} sky-video"><div class="sky-video-frame">{{ if .V.IsEmbed }}<iframe src="{{ .V.EmbedSrc }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy" title="{{ .V.Title }}"></iframe>{{ else }}<video{{ if .V.Poster }} poster="{{ .V.Poster }}"{{ end }}{{ if .V.Autoplay }} autoplay{{ end }}{{ if .V.Loop }} loop{{ end }}{{ if .V.Muted }} muted{{ end }}{{ if .V.Controls }} controls{{ end }} playsinline preload="{{ .V.Preload }}"><source src="{{ .V.Src }}">{{ if .V.CaptionsSrc }}<track kind="captions" src="{{ .V.CaptionsSrc }}" label="{{ .V.CaptionsLabel }}" srclang="{{ .V.CaptionsLang }}" default>{{ end }}</video>{{ end }}</div></div>