{
  "schemaVersion": 1,
  "settings": {
    "layout": {
      "mode": "full"
    },
    "base": {
      "backgroundColor": "#f5f5f6"
    }
  },
  "root": [
    {
      "id": "commerce-intro",
      "type": "core.container",
      "name": "结算流程介绍",
      "props": {
        "tag": "header",
        "layout": {
          "engine": "flex",
          "flex": {
            "direction": "column",
            "gap": "12px"
          }
        },
        "box": {
          "maxWidth": "1120px",
          "center": true,
          "padding": {
            "desktop": "56px 32px 28px",
            "mobile": "28px 20px"
          }
        }
      },
      "children": [
        {
          "id": "commerce-eyebrow",
          "type": "core.text",
          "name": "流程提示",
          "props": {
            "mode": "plaintext",
            "plainTag": "p",
            "text": "01 商品确认　·　02 收货与结算　·　03 订单结果",
            "color": "#73747a",
            "typography": {
              "desktop": {
                "fontSize": "12px"
              }
            }
          }
        },
        {
          "id": "commerce-title",
          "type": "core.heading",
          "name": "页面标题",
          "props": {
            "tag": "h1",
            "text": "每一件心意，都值得认真对待。",
            "color": "#202124",
            "weight": "600",
            "typography": {
              "desktop": {
                "fontSize": "36px",
                "lineHeight": "1.2"
              },
              "mobile": {
                "fontSize": "28px"
              }
            }
          }
        },
        {
          "id": "commerce-help",
          "type": "core.text",
          "name": "流程说明",
          "props": {
            "mode": "plaintext",
            "plainTag": "p",
            "text": "先确认商品，再填写收货信息。数量与金额会按最新购物车更新。",
            "color": "#73747a"
          }
        }
      ]
    },
    {
      "id": "commerce-content",
      "type": "core.container",
      "name": "购物车与结算",
      "props": {
        "tag": "main",
        "layout": {
          "engine": "grid",
          "grid": {
            "columns": {
              "desktop": 2,
              "tablet": 1,
              "mobile": 1
            },
            "columnGap": "24px",
            "rowGap": "24px"
          }
        },
        "box": {
          "maxWidth": "1120px",
          "center": true,
          "padding": {
            "desktop": "0px 32px 64px",
            "mobile": "0px 20px 32px"
          }
        }
      },
      "children": [
        {
          "id": "commerce-cart-card",
          "type": "core.container",
          "name": "商品确认",
          "props": {
            "tag": "section",
            "layout": {
              "engine": "flex",
              "flex": {
                "direction": "column",
                "gap": "20px"
              }
            },
            "box": {
              "padding": {
                "desktop": "28px",
                "mobile": "20px"
              }
            },
            "visual": {
              "bgColor": "#ffffff",
              "radius": "20px"
            }
          },
          "children": [
            {
              "id": "commerce-cart",
              "type": "core.cartIcon",
              "name": "完整购物车",
              "props": {
                "mode": "inline",
                "label": "购物车",
                "showCount": true,
                "color": "#202124"
              },
              "actions": {
                "checkout": {
                  "kind": "instance",
                  "nodeId": "commerce-checkout",
                  "partKey": "checkout"
                }
              }
            }
          ]
        },
        {
          "id": "commerce-checkout-card",
          "type": "core.container",
          "name": "收货信息",
          "props": {
            "tag": "section",
            "layout": {
              "engine": "flex",
              "flex": {
                "direction": "column",
                "gap": "20px"
              }
            },
            "box": {
              "padding": {
                "desktop": "28px",
                "mobile": "20px"
              }
            },
            "visual": {
              "bgColor": "#ffffff",
              "radius": "20px"
            }
          },
          "children": [
            {
              "id": "commerce-checkout-title",
              "type": "core.heading",
              "name": "结算标题",
              "props": {
                "tag": "h2",
                "text": "收货与结算",
                "weight": "600",
                "color": "#202124",
                "typography": {
                  "desktop": {
                    "fontSize": "24px"
                  }
                }
              }
            },
            {
              "id": "commerce-checkout",
              "type": "core.checkoutForm",
              "name": "收货与结算",
              "props": {
                "submitLabel": "确认并提交订单",
                "collectBilling": false
              },
              "actions": {
                "back": {
                  "kind": "instance",
                  "nodeId": "commerce-cart",
                  "partKey": "cart"
                },
                "success": {
                  "kind": "local",
                  "partKey": "result"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
