  "decisions": [
    {
      "id": "DEC-REG-JSON",
      "question": "内置组件注册能不能改成 json/yaml？",
      "answer": "不能全量改。CompileCSS / BuildView / Validate 是编译期逻辑，声明式引擎盖不住（cardstack 三角函数、button 的 a/button 二选一、AddHover 三桶）。插件已经走 manifest.json，展示型继续那条。内置组件该修的是双 import 清单和漏登记无测试（REG-001 / REG-002），外加 palette 元数据上移（REG-005）。",
      "see": [
        "REG-003",
        "REG-001",
        "REG-002",
        "REG-004",
        "REG-005",
        "VIS-015"
      ]
    },
    {
      "id": "DEC-UI-SHARED",
      "question": "控件库能不能同时给组件和后台调用？",
      "answer": "源可以继续共用，投递必须分层：后台常驻、产物按特征裁剪。当前卡在三件事：产物白名单远小于后台清单、注入只认 data-* 不认 class、组件与基座属性名对不上。令牌层应该先统一变量名，keyframes 清单不要硬共享（营销动效不该进后台）。",
      "see": [
        "UIK-001",
        "UIK-002",
        "UIK-003",
        "UIK-004",
        "UIK-007",
        "UIK-013",
        "UIK-014"
      ]
    }
  ],
